// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id                   String                        @id @default(cuid())
  title                String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug                 String?                       @unique
  venue                String
  description          String?
  // Откуда событие импортировано (ThaiTicketMajor) — блок «Источники»
  // на странице; у добавленных руками null.
  sourceUrl            String?
  presaleAt            DateTime?
  presaleUrl           String?
  // Free-text ticket price display string (e.g. "6,900 / 5,900 / 5,000
  // baht") — deliberately not a structured number, since sources like
  // ThaiTicketMajor list several tiers as one string.
  ticketPrice          String?
  posterUrl            String?
  // Optional tie-in to a drama this event is about (premiere screening,
  // fan meet for the cast, etc.) — one event belongs to at most one drama.
  dramaId              String?
  drama                Drama?                        @relation(fields: [dramaId], references: [id])
  // Optional link to a known real-world Location (venue reused from a
  // filming-location page, a recurring fan-meet spot, etc.) — `venue`
  // stays the free-text display string either way; this just lets the
  // event show up on that Location's page and on the map.
  locationId           String?
  location             Location?                     @relation(fields: [locationId], references: [id])
  // A multi-day concert is still ONE Event (one title/venue/cast/
  // favorite/going state) with several occurrences — it shows up once
  // per day in listings/calendar, but editing or deleting it acts on the
  // whole thing at once. See docs/features/events.md.
  occurrences          EventOccurrence[]
  performers           EventPerformer[]
  pairings             EventPairing[]
  favoritedBy          FavoriteEvent[]
  attendees            EventAttendance[]
  notes                EventNote[]
  presaleNotifications TelegramPresaleNotification[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  reviews              Review[]
  comments             Comment[]
  tickets              EventTicket[]
}

model EventOccurrence {
  id                    String                 @id @default(cuid())
  eventId               String
  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startsAt              DateTime
  endsAt                DateTime?
  // Время не указано — startsAt хранит 00:00, hasTime=false (иначе
  // полночь неотличима от «без времени»).
  hasTime               Boolean                @default(true)
  // Состав конкретного дня (фестивали: в разные дни — разные группы).
  // Пусто = день наследует общий состав события.
  lineup                OccurrenceLineup[]
  telegramNotifications TelegramNotification[]
  attendances           EventAttendance[]
  tickets               EventTicket[]

  @@index([eventId])
  @@index([startsAt])
}

model Performer {
  id   String        @id @default(cuid())
  name String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug String?       @unique
  type PerformerType @default(SOLO)

  // Profile fields (populated manually or via mydramalist import).
  realName       String?
  birthDate      DateTime?
  placeOfBirth   String?
  bio            String?
  // A performer can belong to more than one agency at once — a co-produced
  // drama's cast may formally be signed to a different studio than the one
  // that produced it, and a performer can move agencies over time. No
  // current-vs-past status yet (see PerformerAgency) — every row is just
  // "this performer is associated with this agency".
  agencies       PerformerAgency[]
  photoUrl       String?
  mydramalistUrl String?
  // TMDB person id — set once a performer's been imported/matched from
  // TMDB (see tmdb-import.md), lets re-imports and cast matching key off
  // a stable id instead of a fuzzy name match.
  tmdbId         String?           @unique

  events                EventPerformer[]
  dramas                PerformerDrama[]
  links                 PerformerLink[]
  favoritedBy           FavoritePerformer[]
  birthdayNotifications BirthdayNotification[]
  personalEvents        TripPersonalEventPerformer[]
  pairingsAsA           Pairing[]                    @relation("PairingA")
  pairingsAsB           Pairing[]                    @relation("PairingB")

  // Band <-> member-actor relation. Only meaningful when type is BAND
  // (bandMembers) or SOLO (memberOfBands) respectively, but left
  // unconstrained at the schema level since either side is just a Performer.
  bandMembers   BandMember[] @relation("BandMembers")
  memberOfBands BandMember[] @relation("MemberOfBands")

  // Маскоты: owners — чей это маскот (сам Performer типа MASCOT),
  // mascots — маскоты этого актёра.
  mascotOwners      MascotOwner[]        @relation("MascotOwners")
  mascots           MascotOwner[]        @relation("PerformerMascots")
  inUserLists       PerformerListItem[]
  seenByUsers       PerformerSeen[]
  scheduledJobs     ScheduledJobTarget[]
  occurrenceLineups OccurrenceLineup[]

  // Музыкальная сторона: сценический псевдоним сольного музыканта
  // (у группы «псевдоним» — это её name) и дискография. Ссылки на муз.
  // площадки (Spotify и т.п.) живут в общих PerformerLink — платформа
  // распознаётся по URL (см. src/lib/socialLinks.ts).
  // --- tpop.fandom (см. tpop-agency-import.md): профиль музыканта ---
  occupation    String[] @default([])
  instruments   String[] @default([])
  soloDebut     String?
  height        String?
  weight        String?
  // «Music video appearances» — просто текстом, без ссылок.
  mvAppearances String[] @default([])
  trivia        String[] @default([])
  // Таблица «Awards and nominations»: [{year, award, category, nominee, result}]
  awards        Json?
  // Секция «References» источника: [{label, url}] + страница-источник.
  references    Json?
  sourceUrl     String?
  musicAlias    String?
  albums        Album[]
  songs         Song[]

  // Данные со страницы MyDramaList (блок Details страницы человека,
  // кроме Native name — см. mydramalist-import.md). mdlSyncedAt —
  // отметка прохода scripts/mdl-sync-performers.ts.
  alsoKnownAs String?
  nationality String?
  gender      String?
  mdlSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

enum PerformerType {
  SOLO
  BAND
  // Маскот (актёра или пейринга): та же карточка Performer — фото, био,
  // др, соцссылки, дискография; «хозяева» — через MascotOwner.
  MASCOT
}

// Привязка маскота к «хозяевам»: актёру и/или пейрингу (у маскота может
// быть несколько хозяев, у актёра/пейринга — несколько маскотов).
model MascotOwner {
  id          String     @id @default(cuid())
  mascotId    String
  mascot      Performer  @relation("MascotOwners", fields: [mascotId], references: [id], onDelete: Cascade)
  performerId String?
  performer   Performer? @relation("PerformerMascots", fields: [performerId], references: [id], onDelete: Cascade)
  pairingId   String?
  pairing     Pairing?   @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@index([mascotId])
  @@index([performerId])
  @@index([pairingId])
}

// Дискография исполнителя (группы или сольного музыканта). Заполняется
// импортом с tpop.fandom.com (scripts/import-tpop-discography.ts) или
// руками; треки альбомов пока не ведём — только сами альбомы и
// отдельные песни/синглы.
model Album {
  id          String    @id @default(cuid())
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  title       String
  type        AlbumType @default(ALBUM)
  year        Int?
  coverUrl    String?
  // Ссылка на площадку/страницу альбома (YouTube/Spotify), если нашлась.
  url         String?
  songs       Song[]
  createdAt   DateTime  @default(now())

  @@unique([performerId, title])
}

enum AlbumType {
  ALBUM
  EP
  SINGLE
}

model Song {
  id          String    @id @default(cuid())
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  albumId     String?
  album       Album?    @relation(fields: [albumId], references: [id], onDelete: SetNull)
  title       String
  // Пояснение из источника: «(with SIZZY)», название OST и т.п.
  note        String?
  year        Int?
  // Ссылка на площадку/клип, если появится источник.
  url         String?
  createdAt   DateTime  @default(now())

  @@index([performerId])
  @@index([albumId])
}

// A talent/management agency. Performers optionally belong to one or more
// (see PerformerAgency); the agency's own roster, description, and
// (later) logo make it a browsable entity in its own right rather than
// just a free-text label.
model Agency {
  id          String            @id @default(cuid())
  name        String            @unique
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug        String?           @unique
  logoUrl     String?
  description String?
  // Страница-источник (Wikipedia/fandom/сайт агентства/TMDB) — блок
  // «Источники»; проставляется импортёрами, у созданных руками null.
  sourceUrl   String?
  performers  PerformerAgency[]
  dramas      Drama[]
  dramaLinks  DramaAgency[]
  favoritedBy FavoriteAgency[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A performer<->agency association — many-to-many since a performer can
// be signed to more than one studio at once (a co-produced drama's cast
// may formally belong to a different studio than the one that produced
// it) or move between agencies over time. No current/past status field
// yet — every row just means "this performer is associated with this
// agency"; deliberately left simple until that distinction is needed.
model PerformerAgency {
  performerId String
  agencyId    String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([performerId, agencyId])
  @@index([agencyId])
}

// A member-actor of a band (e.g. an idol/actor who's also in a group).
// Bands don't get pairings or dramas of their own — those stay per-member.
model BandMember {
  bandId      String
  performerId String
  band        Performer @relation("BandMembers", fields: [bandId], references: [id], onDelete: Cascade)
  performer   Performer @relation("MemberOfBands", fields: [performerId], references: [id], onDelete: Cascade)

  @@id([bandId, performerId])
  @@index([performerId])
}

// Arbitrary "extra info" links per performer — personal brand, café,
// social media, etc. Free-form label so the admin can add whatever's
// relevant without a schema change.
model PerformerLink {
  id          String    @id @default(cuid())
  performerId String
  label       String
  url         String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@index([performerId])
}

// Лайнап конкретного дня фестиваля (см. EventOccurrence.lineup).
model OccurrenceLineup {
  occurrenceId String
  performerId  String
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  performer    Performer       @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@id([occurrenceId, performerId])
  @@index([performerId])
}

model EventPerformer {
  eventId     String
  performerId String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@id([eventId, performerId])
  @@index([performerId])
}

// Новелла-первоисточник: многие лакорны — экранизации веб-новелл.
// Ссылки — где почитать/купить/скачать (свободный label+url).
model Novel {
  id             String      @id @default(cuid())
  title          String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts).
  slug           String?     @unique
  author         String?
  coverUrl       String?
  description    String?
  // Поля импорта с Фикбука (см. ficbook-import в admin/novels):
  // автор оригинала (для переводов), теги-бейджи (Слэш, Перевод, NC-17,
  // Завершён) вместе с «Метками», размер («N страниц, M слов»).
  originalAuthor String?
  tags           String[]    @default([])
  size           String?
  links          NovelLink[]
  dramas         Drama[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  reviews        Review[]
  comments       Comment[]

  @@index([title])
}

model NovelLink {
  id      String @id @default(cuid())
  novelId String
  label   String
  url     String
  novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model Drama {
  id             String        @id @default(cuid())
  title          String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug           String?       @unique
  mydramalistUrl String?
  // Русские название и описание — с dorama.land (см.
  // features/doramaland-import.md). Русская версия сайта показывает их
  // вместо английских, когда они есть; «нет ру перевода» в админке —
  // это просто titleRu IS NULL.
  titleRu        String?
  synopsisRu     String?
  doramalandUrl  String?       @unique
  posterUrl      String?
  synopsis       String?
  year           Int?
  status         DramaStatus?
  // TV channel/streaming platform it aired (or will air) on — TMDB
  // doesn't reliably carry this for Thai networks, so it comes from
  // agency Wikipedia imports instead (see wikipedia-agency-import.md).
  network        String?
  // Основное агентство (легаси, одно) + полный набор через DramaAgency:
  // у сериала бывает несколько студий-производителей.
  agencyId       String?
  agency         Agency?       @relation(fields: [agencyId], references: [id])
  agencies       DramaAgency[]
  // Первоисточник-новелла (если сериал — экранизация).
  novelId        String?
  novel          Novel?        @relation(fields: [novelId], references: [id])
  // The blscene.com "where was X filmed" page this drama was imported from,
  // if any — used to dedupe re-imports (its on-page title can differ from
  // the A-Z index's link text, so title matching alone isn't reliable).
  blsceneUrl     String?       @unique
  // TMDB TV show id, set once imported/matched from TMDB — see
  // tmdb-import.md. Same dedupe role as blsceneUrl, for a different source.
  tmdbId         String?       @unique

  // Данные со страницы MyDramaList (см. mydramalist-import.md):
  // блок Details + рейтинг. mdlSyncedAt — отметка последнего прохода
  // scripts/mdl-sync-dramas.ts (для резюма больших прогонов).
  nativeTitle   String?
  alsoKnownAs   String?
  director      String?
  screenwriter  String?
  genres        String[]  @default([])
  tags          String[]  @default([])
  episodes      Int?
  airedFrom     DateTime?
  airedTo       DateTime?
  airedOn       String?
  duration      String?
  contentRating String?
  // Страна и тип со страницы MDL («Thailand», «Drama»/«Movie»/«Special»).
  // Свободным текстом, а не перечислением: словарь у MDL свой и он
  // меняется, а жёсткий enum ронял бы импорт на каждом новом значении.
  country       String?
  type          String?
  mdlScore      Float?
  mdlSyncedAt   DateTime?
  // Страница-источник на MyDramaList. Хранится, чтобы сериал можно было
  // переимпортировать позже: сама по себе ссылка не выводится из
  // названия — в ней числовой id. Заодно ключ дедупликации, как
  // blsceneUrl и tmdbId для своих источников.
  mdlUrl        String?   @unique
  // «Обновлять по расписанию». Отдельный флаг, а не «есть mdlUrl»:
  // ссылка есть у всего импортированного (тысячи записей), а ночью
  // обходить нужно только то, что ещё выходит и потому меняется.
  mdlAutoUpdate Boolean   @default(false)

  // Связанные тайтлы из блока Related Content (сиквелы, uncut-версии,
  // общая вселенная) — направленная связь с подписью отношения.
  relatedFrom DramaRelation[] @relation("RelatedFrom")
  relatedTo   DramaRelation[] @relation("RelatedTo")

  performers    PerformerDrama[]
  watchStatuses DramaWatchStatus[]
  episodeList   DramaEpisode[]
  events        Event[]
  locations     DramaLocation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reviews   Review[]
  comments  Comment[]

  @@index([title])
}

// «Related Content» с MyDramaList: drama → related с подписью
// («Thai shared universe», «Thai compilation», «sequel» и т.п.).
// Сериал ↔ студии: many-to-many, как PerformerAgency у исполнителей.
model DramaAgency {
  dramaId  String
  agencyId String
  drama    Drama  @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@id([dramaId, agencyId])
  @@index([agencyId])
}

model DramaRelation {
  id        String  @id @default(cuid())
  dramaId   String
  relatedId String
  relation  String?
  drama     Drama   @relation("RelatedFrom", fields: [dramaId], references: [id], onDelete: Cascade)
  related   Drama   @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([dramaId, relatedId])
  @@index([relatedId])
}

// TMDB's own TV status vocabulary — whether a show has finished airing or
// not, distinct from a user's personal WatchStatus above.
enum DramaStatus {
  RETURNING_SERIES
  PLANNED
  IN_PRODUCTION
  ENDED
  CANCELED
  PILOT
}

// A real-world filming location (café, park, venue…) tied to one or more
// dramas. Kept its own entity (not a free-text field) so it's browsable and
// so users can track which ones they've actually visited.
// Категория места. Список закрытый: по нему строятся фильтры и иконки,
// а свободный текст в них превращается в кашу из синонимов.
enum LocationCategory {
  CAFE
  RESTAURANT
  SHOP
  MALL
  HOTEL
  PHOTO_SPOT
  LANDMARK
  PARK
  TRANSPORT
  OTHER
}

model Location {
  id              String              @id @default(cuid())
  name            String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug            String?             @unique
  description     String?
  // Откуда взята локация — блок «Источники» на её странице (см.
  // features/locations.md). Каталожные локации пришли с blscene.com, и
  // атрибуция там обязательна; у мест, созданных пользователями
  // (createdByUserId), источника нет.
  sourceUrl       String?
  // Что это за место: кафе, магазин, отель… Нужна для фильтров в
  // списках мест и в «Что посетить» внутри поездки, и для иконок на
  // карте. Правится в админке; у части каталожных локаций пустая.
  category        LocationCategory?
  // Инстаграм заведения, сайт, канал — фандом чаще всего находит места
  // именно по инстаграму.
  links           LocationLink[]
  photoUrl        String?
  latitude        Float?
  longitude       Float?
  // Место, созданное пользователем для своих списков/поездок (а не
  // импортированное из каталога дорам): в общий каталог/карту/админку
  // такие не попадают — видны только через списки и поиск автора.
  createdByUserId String?
  createdBy       User?               @relation("UserCreatedLocations", fields: [createdByUserId], references: [id], onDelete: Cascade)
  dramas          DramaLocation[]
  visitedBy       LocationVisit[]
  events          Event[]
  listItems       PlaceListItem[]
  tripPlaces      TripPlace[]
  personalEvents  TripPersonalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model DramaLocation {
  dramaId    String
  locationId String
  drama      Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([dramaId, locationId])
  @@index([locationId])
}

// A user marking a location as visited — analogous to EventAttendance but
// for locations, with no "favorite" concept of its own.
model LocationVisit {
  userId     String
  locationId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, locationId])
  @@index([locationId])
}

enum WatchStatus {
  WATCHING
  COMPLETED
  ON_HOLD
  PLAN_TO_WATCH
  DROPPED
}

// Per-user watch-progress tracking for a drama (MyDramaList-style status).
// This is the only per-user "how do I feel about this drama" signal —
// there's deliberately no separate drama favorite/heart, unlike
// performers/events/agencies (see docs/features/social.md).
/**
 * Расписание серий: какая серия на какое число.
 * Отдельными строками, а не вычислением «airedFrom + неделя × номер»:
 * у сериалов бывают перерывы, сдвоенные показы и спецвыпуски, и
 * посчитанная дата врала бы ровно там, где на неё смотрят — «выходит ли
 * сегодня». Даты приходят со страницы /episodes на MyDramaList.
 */
model DramaEpisode {
  id      String    @id @default(cuid())
  dramaId String
  drama   Drama     @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  number  Int
  // null — дату ещё не объявили: у выходящего сериала хвост расписания
  // обычно пустой, и это не то же самое, что «серии нет».
  airDate DateTime?
  title   String?

  @@unique([dramaId, number])
  // Под запрос «что выходит сегодня» на главной.
  @@index([airDate])
}

model DramaWatchStatus {
  userId          String
  dramaId         String
  status          WatchStatus
  // На какой серии человек остановился. null — не отмечал: это не то же
  // самое, что 0 («начал и не посмотрел ни одной»), и прогресс-бар в
  // первом случае не рисуется вовсе. Общее число серий берётся из
  // Drama.episodes и тоже бывает неизвестным — тогда счётчик работает
  // без верхней границы.
  episodesWatched Int?
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama           Drama       @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  updatedAt       DateTime    @updatedAt

  @@id([userId, dramaId])
  @@index([dramaId])
}

model PerformerDrama {
  performerId String
  dramaId     String
  role        String? // character name, optional
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  drama       Drama     @relation(fields: [dramaId], references: [id], onDelete: Cascade)

  @@id([performerId, dramaId])
  @@index([dramaId])
}

// A named pairing ("ship") of two performers, selectable on events instead
// of / alongside individual performers.
model Pairing {
  id           String         @id @default(cuid())
  name         String?
  status       PairingStatus  @default(CURRENT)
  performerAId String
  performerBId String
  performerA   Performer      @relation("PairingA", fields: [performerAId], references: [id], onDelete: Cascade)
  performerB   Performer      @relation("PairingB", fields: [performerBId], references: [id], onDelete: Cascade)
  events       EventPairing[]

  createdAt DateTime      @default(now())
  mascots   MascotOwner[]

  @@unique([performerAId, performerBId])
  @@index([performerBId])
}

enum PairingStatus {
  CURRENT
  PAST
}

model EventPairing {
  eventId   String
  pairingId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pairing   Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@id([eventId, pairingId])
  @@index([pairingId])
}

// ---------- User accounts (separate from the single admin password) ----------

model User {
  id                       String          @id @default(cuid())
  // Both nullable because a Telegram-auth account has neither — an
  // email+password account always has both (enforced in the signup
  // action, not the schema).
  // Ник: публичная часть ссылки (/users/keetmine), уникален и виден
  // всем. Предзаполняется на шаге после регистрации из Telegram-username
  // или части почты — так человек не застревает на форме, — но его
  // можно изменить.
  username                 String?         @unique
  email                    String?         @unique
  passwordHash             String?
  // Роль админа: доступ к /admin без отдельного пароля — обычная
  // сессия пользователя + этот флаг (см. requireAdmin в lib/auth.ts).
  isAdmin                  Boolean         @default(false)
  // Менеджер каталога: полный доступ к разделам «Каталог» админки
  // (события, исполнители, сериалы, новеллы, локации, импорты), но без
  // пользователей, финансов, рассылок и настроек — это только админ.
  isManager                Boolean         @default(false)
  auditLogs                AuditLog[]
  notifications            Notification[]  @relation("UserNotifications")
  performersSeen           PerformerSeen[]
  // Что дублировать в Telegram (уведомления на сайте приходят всегда).
  // Раньше набор поводов был зашит в код и одинаков для всех.
  tgNotifyInvites          Boolean         @default(true)
  tgNotifyFriends          Boolean         @default(true)
  tgNotifyReplies          Boolean         @default(true)
  tgNotifyEvents           Boolean         @default(true)
  // Дни рождения избранных артистов (З3). Свой переключатель, а не
  // общий с событиями: повод ежедневный и нравится далеко не всем, а
  // «друзья идут на события» человек может хотеть оставить.
  tgNotifyBirthdays        Boolean         @default(true)
  // Новости проекта из /admin/broadcast — раньше рассылка игнорировала
  // настройки и уходила всем с привязанным Telegram.
  tgNotifyBroadcast        Boolean         @default(true)
  // Тур по интерфейсу для новичков: показывается один раз после
  // регистрации, перезапускается кнопкой в настройках.
  tourCompletedAt          DateTime?
  // Мягкое удаление: запись остаётся (её связи — комментарии, отзывы,
  // участие в поездках — иначе исчезли бы каскадом), но аккаунт нигде не
  // показывается и войти в него нельзя. Уникальные поля при удалении
  // освобождаются — иначе почта и Telegram остались бы занятыми навсегда.
  deletedAt                DateTime?
  actedNotifications       Notification[]  @relation("NotificationActor")
  // Google-аккаунт (OAuth): sub из id_token. Set = "может войти через Google".
  googleId                 String?         @unique
  name                     String?
  photoUrl                 String?
  // Telegram user id from the Login Widget (doubles as the DM chat id
  // for bot notifications). Set = "can log in via Telegram".
  telegramId               String?         @unique
  telegramUsername         String?
  // Подписка действует, пока premiumUntil в будущем (null — не было).
  // Продлевается из админки (+1 месяц) или оплатой; гейты проверяют
  // через isPremiumActive() (src/lib/premium.ts).
  premiumUntil             DateTime?
  // Для какого premiumUntil уже отправлено телеграм-напоминание об
  // истечении — дедуп напоминалки «подписка кончается через 3 дня».
  premiumExpiryNotifiedFor DateTime?
  // Opaque token for the read-only "subscribe to my calendar" ICS feed —
  // generated on first request since calendar apps fetch it without a
  // session cookie, so it needs its own unguessable credential.
  icsToken                 String?         @unique
  // Таймзона для «времени в скобках» рядом с тайским (дефолт — МСК).
  timezone                 String          @default("Europe/Moscow")
  // Когда человек последний раз что-то делал на сайте. Обновляется не
  // на каждый запрос, а раз в несколько минут (см. lib/lastSeen.ts):
  // запись на каждый чих утроила бы количество записей в базу ради
  // поля, которое смотрят раз в неделю в админке.
  lastSeenAt               DateTime?
  // Язык, выбранный человеком явно. null — не выбирал: тогда решает
  // язык браузера. Нужен помимо куки для того, что уходит человеку ВНЕ
  // запроса — уведомления в Telegram, название календарной подписки, —
  // там браузера с его кукой рядом нет. Куку это поле не заменяет:
  // proxy ходит на каждый запрос и в базу не лезет, поэтому язык из
  // профиля кладётся в куку при входе.
  locale                   String?
  // Профиль: заполняется по желанию на шаге после регистрации и в
  // настройках.
  country                  String?
  gender                   String?
  birthDate                DateTime?
  bio                      String?
  createdAt                DateTime        @default(now())

  sessions                     UserSession[]
  favoritePerformers           FavoritePerformer[]
  favoriteEvents               FavoriteEvent[]
  favoriteAgencies             FavoriteAgency[]
  eventAttendances             EventAttendance[]
  dramaWatchStatuses           DramaWatchStatus[]
  visitedLocations             LocationVisit[]
  trips                        Trip[]
  telegramNotifications        TelegramNotification[]
  telegramPresaleNotifications TelegramPresaleNotification[]
  birthdayNotifications        BirthdayNotification[]
  friendMutes                  FriendNotificationMute[]      @relation("MuteOwner")
  mutedByFriends               FriendNotificationMute[]      @relation("MuteTarget")
  eventNotes                   EventNote[]
  achievements                 UserAchievement[]
  placeLists                   PlaceList[]
  performerLists               PerformerList[]
  tripMemberships              TripMember[]
  reviews                      Review[]
  comments                     Comment[]
  commentLikes                 CommentLike[]
  passwordResetTokens          PasswordResetToken[]
  createdLocations             Location[]                    @relation("UserCreatedLocations")
  // Приватность публичного профиля. Друзья видят всё всегда.
  // hideProfileActivity — мастер-выключатель (чужие видят только
  // имя/фото); остальные — точечные блоки при открытом профиле.
  hideProfileActivity          Boolean                       @default(false)
  hideAchievements             Boolean                       @default(false)
  hideFavoritePerformers       Boolean                       @default(false)
  hideVisitedPlaces            Boolean                       @default(false)

  feedbacks              Feedback[]
  reports                Report[]
  payments               Payment[]
  friendRequestsSent     Friendship[]  @relation("FriendRequester")
  friendRequestsReceived Friendship[]  @relation("FriendAddressee")
  redeemedPromoCodes     PromoCode[]   @relation("PromoRedeemer")
  eventTickets           EventTicket[]
}

// A user's planned trip (to Thailand) — a named date range; the trip page
// shows every event occurrence falling inside it, so "what's happening
// while I'm there" is one click instead of a manual date-range filter.
model Trip {
  id             String              @id @default(cuid())
  userId         String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug           String?             @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  startDate      DateTime
  endDate        DateTime
  // Кто может открыть страницу поездки: PRIVATE — только владелец,
  // FRIENDS — владелец и его принятые друзья, PUBLIC — любой залогиненный.
  // Личные события поездки при этом видны только владельцу всегда.
  visibility     TripVisibility      @default(PRIVATE)
  createdAt      DateTime            @default(now())
  personalEvents TripPersonalEvent[]
  placeLists     TripPlaceList[]
  places         TripPlace[]
  todos          TripTodo[]
  members        TripMember[]
  bookings       TripBooking[]

  @@index([userId])
}

enum TripVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

// A user's own private entry inside a trip (dinner reservation, museum
// day, flight) — rendered chronologically among the public events of the
// trip's date range, visible only to the trip's owner. Deliberately much
// simpler than Event: one date/time, free-text note, no venue entity or
// performers.
// Со-путешественник: полноценный доступ к поездке (видит всё, вносит
// события/дела). Права на чужие записи — по editableByOthers записи;
// владелец поездки может всё. Добавление — через инвайт: PENDING до
// принятия, участником считается только ACCEPTED.
enum TripMemberStatus {
  PENDING
  ACCEPTED
}

model TripMember {
  tripId    String
  userId    String
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    TripMemberStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@id([tripId, userId])
  @@index([userId])
}

model TripPersonalEvent {
  id               String                       @id @default(cuid())
  tripId           String
  trip             Trip                         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title            String
  note             String?
  startsAt         DateTime
  // Личное событие можно привязать к известной локации — карточка
  // показывает место со ссылкой, оно попадает на карту поездки.
  locationId       String?
  location         Location?                    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  // Совместные поездки: кто создал запись (null — владелец поездки,
  // легаси) и можно ли другим участникам её править/удалять.
  createdById      String?
  editableByOthers Boolean                      @default(false)
  // Приватная запись — видна только автору, даже другим участникам.
  // Историческое поле, его заменяет visibility.
  isPrivate        Boolean                      @default(false)
  visibility       TripItemVisibility           @default(PARTICIPANTS)
  // Кто из артистов будет на событии (фанмит, ужин с актёром): после
  // даты события они попадают в «видел(а) вживую» создателя записи —
  // см. lib/userStats.ts.
  performers       TripPersonalEventPerformer[]
  // Показывать в блоке «Вы идёте» на главной (Ж11) — по желанию:
  // перелёты и брони на главной не нужны, а встреча с друзьями — да.
  showOnHome       Boolean                      @default(false)
  // Картинка к записи (скан билета, скрин брони, афиша) — приватная,
  // как и сама запись: лежит в private-uploads/, раздаётся через
  // /files/personal/… с проверкой участия в поездке.
  imageUrl         String?
  createdAt        DateTime                     @default(now())

  @@index([tripId])
}

// Пользовательская подборка локаций («где вкусная еда», «кафешки из
// дорам») — с той же моделью видимости, что у поездок. Показывается
// списком и на карте; прикрепляется к поездкам (TripPlaceList).
// Кастомный список актёров пользователя («пил пиво», «видела вживую»…)
// — аналог PlaceList, та же видимость и слаг название+код.
model PerformerList {
  id          String              @id @default(cuid())
  userId      String
  slug        String?             @unique
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  TripVisibility      @default(PRIVATE)
  items       PerformerListItem[]
  createdAt   DateTime            @default(now())

  @@index([userId])
}

model PerformerListItem {
  listId      String
  performerId String
  note        String?
  position    Int           @default(0)
  list        PerformerList @relation(fields: [listId], references: [id], onDelete: Cascade)
  performer   Performer     @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@id([listId, performerId])
  @@index([performerId])
}

model PlaceList {
  id          String          @id @default(cuid())
  userId      String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug        String?         @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  TripVisibility  @default(PRIVATE)
  items       PlaceListItem[]
  trips       TripPlaceList[]
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model PlaceListItem {
  listId     String
  locationId String
  note       String?
  // Ручной порядок в списке (кнопки вверх/вниз); сортировка
  // (position, createdAt) — у старых записей position 0.
  position   Int       @default(0)
  list       PlaceList @relation(fields: [listId], references: [id], onDelete: Cascade)
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@id([listId, locationId])
  @@index([locationId])
}

// Прикрепление целого списка мест к поездке.
// Туду-лист поездки: пункт с чекбоксом и (необязательно) датой —
// датированные дела попадают в хронологию «Мой план».
// Кто видит отдельную запись внутри поездки — дело, бронь, личное
// событие. Отдельно от видимости самой поездки: поездку можно открыть
// друзьям, а бронь отеля с адресом и номером — нет.
//
// Заводится рядом с существующим isPrivate, а не вместо него: сначала
// поле появляется и заполняется, потом код переходит на него, и только
// после этого isPrivate убирается. Обратный порядок уронил бы прод в
// промежутке между миграцией и выкаткой кода.
enum TripItemVisibility {
  // Только автор записи.
  PRIVATE
  // Участники поездки — так ведут себя записи, созданные до этого поля.
  PARTICIPANTS
  // Друзья автора, если сама поездка им видна.
  FRIENDS
  // Все, кому видна поездка.
  PUBLIC
}

model TripTodo {
  id               String             @id @default(cuid())
  tripId           String
  trip             Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text             String
  done             Boolean            @default(false)
  date             DateTime?
  // Совместные поездки: автор и право правки другими участниками.
  createdById      String?
  editableByOthers Boolean            @default(false)
  // Приватное дело — видно только автору. Историческое поле, его
  // заменяет visibility (см. комментарий у TripItemVisibility).
  isPrivate        Boolean            @default(false)
  visibility       TripItemVisibility @default(PARTICIPANTS)
  // Время указано? (date хранит и время; без флага «00:00» неотличим
  // от «без времени»).
  hasTime          Boolean            @default(false)
  createdAt        DateTime           @default(now())

  @@index([tripId])
}

model TripPlaceList {
  tripId String
  listId String
  trip   Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  list   PlaceList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([tripId, listId])
}

// Отдельное важное место, добавленное прямо в поездку (без списка).
model TripPlace {
  tripId     String
  locationId String
  note       String?
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([tripId, locationId])
}

// Дедуп пресейл-напоминаний: одно на (юзер, событие) — сама препродажа
// у события одна (Event.presaleAt), в отличие от дат выступлений.
/**
 * Кому про чей день рождения уже сказали в этом году (З3).
 * Год в ключе, а не дата: планировщик просыпается каждые полчаса, и без
 * отметки человек получал бы поздравление двадцать раз за сутки. На
 * следующий год та же пара сработает снова — потому и год, а не просто
 * пара (userId, performerId).
 */
model BirthdayNotification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  year        Int
  createdAt   DateTime  @default(now())

  @@unique([userId, performerId, year])
  @@index([performerId])
}

model TelegramPresaleNotification {
  userId  String
  eventId String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentAt  DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

// «Отписка» от уведомлений о конкретном друге: по умолчанию уведомления
// о всех друзьях включены, строка здесь их выключает (userId больше не
// получает «mutedFriend идёт на …»).
model FriendNotificationMute {
  userId        String
  mutedFriendId String
  user          User     @relation("MuteOwner", fields: [userId], references: [id], onDelete: Cascade)
  mutedFriend   User     @relation("MuteTarget", fields: [mutedFriendId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([userId, mutedFriendId])
}

// Заметка пользователя к событию — личная или видимая друзьям. Одна на
// (юзер, событие): редактируется, а не копится.
model EventNote {
  id         String         @id @default(cuid())
  userId     String
  eventId    String
  text       String
  visibility NoteVisibility @default(PERSONAL)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
}

enum NoteVisibility {
  PERSONAL
  FRIENDS
  // Видна со-путешественникам: участникам общих совместных поездок автора.
  TRIP
}

// Определения ачивок (Э2ф): раньше были зашиты в код, теперь редактируются
// в /admin/achievements. `metric` — ключ из фиксированного набора способов
// подсчёта (METRICS в src/lib/achievements.ts): само вычисление остаётся
// кодом, БД задаёт только «какая метрика и какой порог». Флаговые метрики
// («Дубль», «Марафон» и т.п.) держат threshold = 1.
model Achievement {
  id        String   @id @default(cuid())
  key       String   @unique
  emoji     String
  title     String
  hint      String
  metric    String
  threshold Int
  // enabled=false прячет ачивку отовсюду (кабинет, профиль, подсчёт
  // прогресса), но уже выданные UserAchievement-строки не трогает.
  enabled   Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

// Разблокированные ачивки (Д2): условия считаются из данных на лету
// (src/lib/achievements.ts), строка фиксирует момент получения — для
// «новых» поздравлений в Telegram и стабильного порядка в профиле.
// `key` ссылается на Achievement.key НАМЕРЕННО без FK: удалённая из
// админки ачивка просто перестаёт показываться, а строка-факт остаётся.
model UserAchievement {
  userId     String
  key        String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

// Dedup ledger for Telegram event reminders — one row per (user,
// occurrence) that's already been messaged, so the periodic job never
// notifies twice about the same date of the same event.
model TelegramNotification {
  userId       String
  occurrenceId String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  sentAt       DateTime        @default(now())

  @@id([userId, occurrenceId])
  @@index([occurrenceId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Directed request row: requester -> addressee. status PENDING until the
// addressee accepts; an accepted row represents the friendship itself (no
// separate row needed on the other side — queries check both directions).
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Промокод подписки: одноразовый, даёт months месяцев премиума при
// активации (генерация в админке, активация на пейволле).
model PromoCode {
  code      String    @id
  months    Int       @default(1)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  usedById  String?
  usedBy    User?     @relation("PromoRedeemer", fields: [usedById], references: [id], onDelete: SetNull)
}

model FavoritePerformer {
  userId      String
  performerId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([userId, performerId])
  @@index([performerId])
}

model FavoriteAgency {
  userId    String
  agencyId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, agencyId])
  @@index([agencyId])
}

model FavoriteEvent {
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

// «Я пойду» — теперь на КОНКРЕТНУЮ дату (occurrence), а не на событие
// целиком: у двухдневного концерта можно идти только на 25-е. eventId
// денормализован для выборок «идёт ли на событие вообще» (индикатор
// друзей, фильтры).
/**
 * Купленный билет — СВОЯ запись, а не поле на отметке «иду».
 * На отметке он жил и погибал вместе с ней: снял «иду» и вернул — билет
 * пропал; админ пересобрал даты события — каскад по occurrenceId унёс
 * отметки вместе с билетами. Файл при этом оставался на диске, но
 * доказать, чей он, было нечем — /files/tickets отвечал «не найдено»
 * (реальный случай на проде, 2026-08-28).
 * Привязка к дате — наводка, а не жизнь билета: пересоздали дату —
 * occurrenceId занулился, билет остался у события.
 */
model EventTicket {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceId String?
  occurrence   EventOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  fileUrl      String
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@index([eventId])
  @@index([occurrenceId])
}

model EventAttendance {
  userId       String
  occurrenceId String
  eventId      String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // ЛЕГАСИ: билет переехал в EventTicket (см. выше) — здесь он погибал
  // вместе с отметкой. Колонка не читается и не пишется; данные
  // скопированы миграцией 20260828130000. Снести при следующей уборке.
  ticketUrl    String?
  createdAt    DateTime        @default(now())

  @@id([userId, occurrenceId])
  @@index([eventId])
  @@index([occurrenceId])
}

// Отзыв (оценка 1–10 + текст) к сериалу/новелле/событию — ровно одна из
// трёх ссылок задана. Один отзыв на юзера на объект: составные @@unique
// работают, т.к. NULL в Postgres не конфликтует.
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dramaId   String?
  drama     Drama?   @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  novelId   String?
  novel     Novel?   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rating    Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dramaId])
  @@unique([userId, novelId])
  @@unique([userId, eventId])
  @@index([dramaId])
  @@index([novelId])
  @@index([eventId])
}

// Комментарий к сериалу/новелле/событию: плоский или ответ (parentId,
// один уровень вложенности) + лайки.
model Comment {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dramaId   String?
  drama     Drama?        @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  novelId   String?
  novel     Novel?        @relation(fields: [novelId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]
  text      String
  createdAt DateTime      @default(now())

  @@index([dramaId])
  @@index([novelId])
  @@index([eventId])
  @@index([parentId])
}

model CommentLike {
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([commentId, userId])
}

// Токен сброса пароля: одноразовый, живёт час. Письмо уходит через SMTP
// (env SMTP_*); без настроенной почты флоу сообщает «недоступно».
model PasswordResetToken {
  token     String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Обращения, модерация, платежи, рассылки, импорты ----------

// Обращение пользователя из формы помощи/поиска: вопрос, предложение
// или запрос на добавление контента (сериала/актёра). Выводится в
// /admin/feedback. TODO: дублировать на почту, когда появится SMTP.
model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      FeedbackKind   @default(QUESTION)
  // Почта для ответа: обращения принимаются и от анонимов (форма
  // открыта), а залогиненным подставляется почта аккаунта.
  email     String?
  text      String
  // Откуда пришло обращение (например, поисковый запрос без результатов).
  context   String?
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())
}

enum FeedbackKind {
  QUESTION
  SUGGESTION
  CONTENT_REQUEST
}

enum FeedbackStatus {
  NEW
  DONE
}

// Жалоба на пользовательский контент (списки, заметки, профили) —
// очередь в /admin/moderation.
model Report {
  id         String       @id @default(cuid())
  reporterId String?
  reporter   User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType String // "placeList" | "profile" | "eventNote"
  targetId   String
  reason     String?
  status     ReportStatus @default(NEW)
  createdAt  DateTime     @default(now())
}

enum ReportStatus {
  NEW
  RESOLVED
}

// Журнал оплат Telegram Stars — раньше successful_payment только
// зачислял премиум и терялся в логах; теперь каждая оплата — строка.
model Payment {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         String    @default("telegram_stars")
  amount           Int // в Stars (XTR)
  telegramChargeId String?   @unique
  // Возврат звёзд (refundStarPayment): Telegram по тому же charge id
  // возвращает оплату пользователю. Держим отметку, чтобы не вернуть
  // дважды и чтобы возвраты не считались в выручке.
  refundedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

// Журнал telegram-рассылок из /admin/broadcast.
model Broadcast {
  id        String   @id @default(cuid())
  text      String
  audience  String // "all" | "premium"
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
}

// Журнал запусков импортов/синков из админки (/admin/imports).
// Что именно создал/обновил автоматический импорт — лента «последнего
// спарсенного» в /admin/imports (руками добавленное сюда не пишется).
model ImportedItem {
  id         String     @id @default(cuid())
  runId      String?
  run        ImportRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  entityType String // performer | agency | event | album | song
  entityId   String
  action     String // created | updated
  label      String
  createdAt  DateTime   @default(now())

  @@index([createdAt])
}

model ImportRun {
  id              String         @id @default(cuid())
  // Отметка «разобрано»: бейдж упавших импортов в сайдбаре считает
  // только непросмотренные, иначе гасить его было нечем.
  reviewedAt      DateTime?
  kind            String // "tmdb-dramas" | "tmdb-performers" | "gmmtv" | "mdl-drama" | "blscene"
  status          String         @default("RUNNING") // RUNNING | DONE | FAILED | CANCELLED
  summary         String?
  // Кнопка «Остановить» в /admin/imports: экшен ставит флаг, а сам
  // импорт проверяет его между элементами и выходит сам
  // (checkImportCancelled в src/lib/importRun.ts). Убивать процесс на
  // полуслове нельзя — уже импортированное должно остаться.
  cancelRequested Boolean        @default(false)
  items           ImportedItem[]
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
}

// Ключ-значение настроек сайта, правится в /admin/settings без деплоя
// (цена подписки и т.п.). Читать через src/lib/siteSettings.ts.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Лог серверных ошибок (instrumentation.onRequestError + точечные
// catch'и) — выводится в /admin/errors.
model ErrorLog {
  id         String    @id @default(cuid())
  // Та же отметка, что у ImportRun: счётчик ошибок в сайдбаре считает
  // только неразобранные.
  reviewedAt DateTime?
  message    String
  stack      String?
  path       String?
  digest     String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// Вики-статья («как купить билеты», «виза в Таиланд»…): HTML из
// админ-редактора, публичная страница /wiki/[slug] (ссылки — в футере).
model WikiArticle {
  id        String   @id @default(cuid())
  slug      String?  @unique
  title     String
  content   String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// История правок каталога: кто, когда и что поменял. Пишется из
// admin server actions через src/lib/audit.ts (см. docs/features/
// audit-log.md). Раньше правки были анонимны — после появления роли
// менеджера стало неясно, кто затёр поле и что там было раньше.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  MERGE
  BULK
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Подпись автора на момент правки: юзера могут удалить, а история
  // должна остаться читаемой.
  userLabel   String
  action      AuditAction
  // Имя Prisma-модели: "Performer", "Drama", "Event"…
  entityType  String
  entityId    String
  // Название записи на момент правки (после удаления её уже не достать).
  entityLabel String
  // [{ field, label, from, to }] — только реально изменившиеся поля.
  changes     Json?
  // Свободная приписка: «слито с X», «массовое действие: 12 записей».
  note        String?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// Уведомление пользователю на сайте (колокольчик в шапке). Появилось
// после того, как выяснилось: приглашение в поездку приходит молча —
// человек узнаёт о нём, только если сам зайдёт в /trips. Так же тихо
// проходили заявки в друзья, ответы на комментарии и лайки.
// См. docs/features/notifications.md.
enum NotificationKind {
  TRIP_INVITE
  TRIP_INVITE_ACCEPTED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  COMMENT_REPLY
  COMMENT_LIKE
  FRIEND_GOING
  PREMIUM_GRANTED
  ACHIEVEMENT
  PERFORMER_BIRTHDAY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  // Кто это сделал — для «Аня пригласила вас в поездку». null у
  // системных (ачивки, выданная подписка).
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Переменные части фразы, замороженные в момент события: имя того,
  // кто её вызвал, и название поездки/события/ачивки. Заморожены
  // потому, что сущность может быть удалена позже, а уведомление
  // должно остаться читаемым; вынесены отдельно потому, что саму фразу
  // складывать при создании нельзя — язык получателя тогда неизвестен,
  // и она собирается при ЧТЕНИИ, на языке того, кто её читает.
  actorName String?
  subject   String?
  // Готовая фраза на языке сайта по умолчанию. Запасной вариант: так
  // читаются строки, созданные до перехода на две части, и такой текст
  // уходит в Telegram (там языка получателя мы тоже не знаем).
  title     String
  body      String?
  // Куда ведёт клик.
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// Ссылка у места: инстаграм заведения, сайт, канал в телеграме.
// Отдельной моделью, а не полем: ссылок бывает несколько, и у каждой
// своя подпись.
model LocationLink {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  label      String
  url        String
  createdAt  DateTime @default(now())

  @@index([locationId])
}

// Бронь жилья внутри поездки: файл брони (как билеты у событий —
// EventAttendance.ticketUrl), название и адрес, даты заезда и выезда.
// Видимость наследуется от поездки: участники видят то же, что и
// владелец (см. features/trips.md).
// Бронирования поездки — отели и перелёты в одной модели: поля у них
// почти совпадают (название, даты, ссылка, файл подтверждения,
// заметка), а различаются только маршрутом. Раньше это был TripHotel
// только под жильё.
enum TripBookingKind {
  HOTEL
  FLIGHT
}

model TripBooking {
  id         String             @id @default(cuid())
  tripId     String
  trip       Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind       TripBookingKind    @default(HOTEL)
  // Отель: название; перелёт: рейс или авиакомпания («TG 975»).
  name       String
  // Отель: адрес. У перелёта не используется.
  address    String?
  // Перелёт: откуда и куда (город или аэропорт).
  fromPlace  String?
  toPlace    String?
  // Ссылка на саму бронь (Booking, письмо) и загруженный файл/скрин.
  url        String?
  fileUrl    String?
  // Отель: заезд/выезд; перелёт: вылет/прилёт.
  startAt    DateTime?
  endAt      DateTime?
  note       String?
  // Кто видит бронь. По умолчанию участники: адрес проживания и номер
  // брони — не то, что показывают всем подряд.
  visibility TripItemVisibility @default(PARTICIPANTS)
  createdAt  DateTime           @default(now())

  @@index([tripId])
}

// «Видела вживую» вручную: концерты до регистрации на сайте, случайные
// встречи и события, которых нет в нашей афише. Считается в статистике
// наравне с отметками «я ходил(а)» — см. features/gamification.md.
model TripPersonalEventPerformer {
  id              String            @id @default(cuid())
  personalEventId String
  personalEvent   TripPersonalEvent @relation(fields: [personalEventId], references: [id], onDelete: Cascade)
  performerId     String
  performer       Performer         @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@unique([personalEventId, performerId])
  @@index([performerId])
}

model PerformerSeen {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  seenAt      DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@unique([userId, performerId])
  @@index([userId])
}

// Расписание фоновых задач: что запускается само, когда и по кому.
// До этого интервалы были зашиты в код (см. src/instrumentation.ts) —
// поменять час прогона можно было только деплоем, а список артистов для
// проверки новинок не выбирался вовсе. Страница — /admin/schedule.
model ScheduledJob {
  // Ключ задачи в коде: "youtube-music", "tmdb-dramas"…
  key         String               @id
  enabled     Boolean              @default(true)
  // Час запуска в зоне сайта (Europe/Moscow, см. TZ в docker-compose).
  hour        Int                  @default(4)
  // Кого проверяем: всех подходящих или только выбранных вручную.
  targetMode  ScheduleTargetMode   @default(ALL)
  targets     ScheduledJobTarget[]
  lastRunAt   DateTime?
  lastStatus  String?
  lastSummary String?
  updatedAt   DateTime             @updatedAt

  @@index([enabled])
}

enum ScheduleTargetMode {
  ALL
  SELECTED
}

// Артист, включённый в задачу вручную (targetMode = SELECTED).
model ScheduledJobTarget {
  id          String       @id @default(cuid())
  jobKey      String
  job         ScheduledJob @relation(fields: [jobKey], references: [key], onDelete: Cascade)
  performerId String
  performer   Performer    @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@unique([jobKey, performerId])
  @@index([jobKey])
}
