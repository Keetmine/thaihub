// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id                          String                        @id @default(cuid())
  title                       String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug                        String?                       @unique
  // Онлайн-встреча сообщества: смотрим вместе из дома, места нет.
  // У каталожных событий всегда false.
  isOnline                    Boolean                       @default(false)
  // Таймзона события (IANA). Даты в EventOccurrence лежат «настенным
  // временем» в UTC-полях — и до 2026-09-17 это всегда были тайские
  // часы. У встречи сообщества в Беларуси время вводят по Минску, и
  // показывать его как тайское с «(МСК 18:10)» в скобках было нелепо
  // (жалоба владельца). Каталожные события — по-прежнему Бангкок
  // (умолчание), встреча наследует зону сообщества при создании.
  timezone                    String                        @default("Asia/Bangkok")
  venue                       String
  description                 String?
  // Откуда событие импортировано (ThaiTicketMajor) — блок «Источники»
  // на странице; у добавленных руками null.
  sourceUrl                   String?
  presaleAt                   DateTime?
  presaleUrl                  String?
  // Free-text ticket price display string (e.g. "6,900 / 5,900 / 5,000
  // baht") — deliberately not a structured number, since sources like
  // ThaiTicketMajor list several tiers as one string.
  ticketPrice                 String?
  posterUrl                   String?
  // Кто проводит (GMM Show, Eventpop…). Отдельным полем, а не строкой в
  // описании: по нему видно организатора в карточке и его можно
  // показывать/фильтровать (правка владельца 2026-09-06).
  organizer                   String?
  // Адрес площадки текстом — район и город со страницы источника;
  // `venue` остаётся отображаемым названием.
  address                     String?
  // Ссылка «посмотреть на карте». Ведёт в Google Maps (источники дают
  // короткие maps.app.goo.gl) — на странице события название площадки
  // становится ссылкой.
  mapsUrl                     String?
  // Жанры/теги события: у фестивалей источник отдаёт их списком, и
  // раньше они уходили в описание текстом.
  tags                        String[]
  // Встреча сообщества (АА25): у каталожного события тут null. Одно
  // поле разделяет афишу и посиделки — выборки каталога обязаны идти
  // через catalogEventsWhere (src/lib/catalogEvents.ts), иначе «пью
  // пиво и смотрю сериал» окажется в общей афише.
  //
  // Встречу видят только участники сообщества, всегда. Был флаг
  // «показывать всем», владелец его отменила (2026-09-08): встреча в
  // общей афише сбивает с толку, а видеть её должны те, кто в
  // сообществе, — им она и показывается отдельной вкладкой афиши.
  communityId                 String?
  community                   Community?                    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  // Кто завёл встречу. У каталожных событий null — их заводит админка
  // и импортёры.
  createdById                 String?
  createdBy                   User?                         @relation("EventAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // Optional tie-in to a drama this event is about (premiere screening,
  // fan meet for the cast, etc.) — one event belongs to at most one drama.
  dramaId                     String?
  drama                       Drama?                        @relation(fields: [dramaId], references: [id])
  // Optional link to a known real-world Location (venue reused from a
  // filming-location page, a recurring fan-meet spot, etc.) — `venue`
  // stays the free-text display string either way; this just lets the
  // event show up on that Location's page and on the map.
  locationId                  String?
  location                    Location?                     @relation(fields: [locationId], references: [id])
  // A multi-day concert is still ONE Event (one title/venue/cast/
  // favorite/going state) with several occurrences — it shows up once
  // per day in listings/calendar, but editing or deleting it acts on the
  // whole thing at once. See docs/features/events.md.
  occurrences                 EventOccurrence[]
  // Ж9: до трёх фото для покупающих билеты (схема зала, бенефиты).
  // Постер остаётся отдельным полем: он идёт в OG-картинку и карточки.
  photos                      EventPhoto[]
  performers                  EventPerformer[]
  pairings                    EventPairing[]
  favoritedBy                 FavoriteEvent[]
  attendees                   EventAttendance[]
  maybes                      EventMaybe[]
  seenPerformers              EventSeenPerformer[]
  notes                       EventNote[]
  presaleNotifications        TelegramPresaleNotification[]
  performerEventNotifications PerformerEventNotification[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  reviews                     Review[]
  comments                    Comment[]
  tickets                     EventTicket[]

  /// Переводы уникальных текстов: { "ru": { "<поле>": "…" } }. Какие
  /// поля переводимы — объявлено в src/lib/entityTranslations.ts, оттуда
  /// же берут список и форма админки, и читалка. Пусто — показывается
  /// оригинал.
  translations Json?

  @@index([createdById])
  @@index([dramaId])
  @@index([locationId])
}

// Ж9: до трёх фото для покупающих билеты (схема зала, цены, бенефиты)
// рядом на странице события. Без типов и подписей — владелец сперва
// просил раздельные озаглавленные блоки, потом упростил до одного ряда.
model EventPhoto {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url     String
  // Порядок — порядок списка в форме админки.
  sort    Int    @default(0)

  @@index([eventId])
}

model EventOccurrence {
  id                    String                 @id @default(cuid())
  eventId               String
  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startsAt              DateTime
  endsAt                DateTime?
  // Время не указано — startsAt хранит 00:00, hasTime=false (иначе
  // полночь неотличима от «без времени»).
  hasTime               Boolean                @default(true)
  // Состав конкретного дня (фестивали: в разные дни — разные группы).
  // Пусто = день наследует общий состав события.
  lineup                OccurrenceLineup[]
  telegramNotifications TelegramNotification[]
  attendances           EventAttendance[]
  maybes                EventMaybe[]
  tickets               EventTicket[]

  tripExpenses TripExpense[]

  @@index([eventId])
  @@index([startsAt])
}

model Performer {
  id   String        @id @default(cuid())
  name String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug String?       @unique
  type PerformerType @default(SOLO)

  // Profile fields (populated manually or via mydramalist import).
  realName         String?
  birthDate        DateTime?
  placeOfBirth     String?
  bio              String?
  // A performer can belong to more than one agency at once — a co-produced
  // drama's cast may formally be signed to a different studio than the one
  // that produced it, and a performer can move agencies over time. No
  // current-vs-past status yet (see PerformerAgency) — every row is just
  // "this performer is associated with this agency".
  agencies         PerformerAgency[]
  photoUrl         String?
  mydramalistUrl   String?
  // TMDB person id — set once a performer's been imported/matched from
  // TMDB (see tmdb-import.md), lets re-imports and cast matching key off
  // a stable id instead of a fuzzy name match.
  tmdbId           String?           @unique
  // Страница артиста на musicfestival.in.th, с которой запись заведена
  // краулером фестивалей (см. docs/features/musicfestival-import.md):
  // ключ повторного матчинга лайнапов (тёзки по имени не разводятся —
  // адрес разводит) и строка в «Источниках». Уникален: одна их
  // страница — один наш исполнитель.
  musicFestivalUrl String?           @unique
  // Заготовка: заведён парсером с одним именем (и фото, если было) и
  // ждёт, когда владелец дополнит карточку. Список — фильтр
  // «Заготовки парсеров» на /admin/performers; снимается сохранением
  // профиля в форме.
  stub             Boolean           @default(false)

  events                EventPerformer[]
  dramas                PerformerDrama[]
  links                 PerformerLink[]
  favoritedBy           FavoritePerformer[]
  birthdayNotifications BirthdayNotification[]
  personalEventDays     TripPersonalEventDayPerformer[]
  personalEventSeen     TripPersonalEventSeen[]
  pairingsAsA           Pairing[]                       @relation("PairingA")
  pairingsAsB           Pairing[]                       @relation("PairingB")

  // Band <-> member-actor relation. Only meaningful when type is BAND
  // (bandMembers) or SOLO (memberOfBands) respectively, but left
  // unconstrained at the schema level since either side is just a Performer.
  bandMembers   BandMember[] @relation("BandMembers")
  memberOfBands BandMember[] @relation("MemberOfBands")

  // Маскоты: owners — чей это маскот (сам Performer типа MASCOT),
  // mascots — маскоты этого актёра.
  mascotOwners      MascotOwner[]        @relation("MascotOwners")
  mascots           MascotOwner[]        @relation("PerformerMascots")
  inUserLists       PerformerListItem[]
  seenByUsers       PerformerSeen[]
  seenAtEvents      EventSeenPerformer[]
  scheduledJobs     ScheduledJobTarget[]
  occurrenceLineups OccurrenceLineup[]

  // Музыкальная сторона: сценический псевдоним сольного музыканта
  // (у группы «псевдоним» — это её name) и дискография. Ссылки на муз.
  // площадки (Spotify и т.п.) живут в общих PerformerLink — платформа
  // распознаётся по URL (см. src/lib/socialLinks.ts).
  // --- tpop.fandom (см. tpop-agency-import.md): профиль музыканта ---
  occupation    String[] @default([])
  instruments   String[] @default([])
  soloDebut     String?
  height        String?
  weight        String?
  // «Music video appearances» — просто текстом, без ссылок.
  mvAppearances String[] @default([])
  trivia        String[] @default([])
  // Таблица «Awards and nominations»: [{year, award, category, nominee, result}]
  awards        Json?
  // Секция «References» источника: [{label, url}] + страница-источник.
  references    Json?
  sourceUrl     String?
  musicAlias    String?
  albums        Album[]
  songs         Song[]

  // Данные со страницы MyDramaList (блок Details страницы человека,
  // кроме Native name — см. mydramalist-import.md). mdlSyncedAt —
  // отметка прохода scripts/mdl-sync-performers.ts.
  alsoKnownAs String?
  nationality String?
  gender      String?
  mdlSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Переводы уникальных текстов: { "ru": { "<поле>": "…" } }. Какие
  /// поля переводимы — объявлено в src/lib/entityTranslations.ts, оттуда
  /// же берут список и форма админки, и читалка. Пусто — показывается
  /// оригинал.
  translations Json?

  @@index([name])
}

enum PerformerType {
  SOLO
  BAND
  // Маскот (актёра или пейринга): та же карточка Performer — фото, био,
  // др, соцссылки, дискография; «хозяева» — через MascotOwner.
  MASCOT
}

// Привязка маскота к «хозяевам»: актёру и/или пейрингу (у маскота может
// быть несколько хозяев, у актёра/пейринга — несколько маскотов).
model MascotOwner {
  id          String     @id @default(cuid())
  mascotId    String
  mascot      Performer  @relation("MascotOwners", fields: [mascotId], references: [id], onDelete: Cascade)
  performerId String?
  performer   Performer? @relation("PerformerMascots", fields: [performerId], references: [id], onDelete: Cascade)
  pairingId   String?
  pairing     Pairing?   @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@index([mascotId])
  @@index([performerId])
  @@index([pairingId])
}

// Дискография исполнителя (группы или сольного музыканта). Заполняется
// импортом с tpop.fandom.com (scripts/import-tpop-discography.ts) или
// руками; треки альбомов пока не ведём — только сами альбомы и
// отдельные песни/синглы.
model Album {
  id          String    @id @default(cuid())
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  title       String
  type        AlbumType @default(ALBUM)
  year        Int?
  coverUrl    String?
  // Ссылка на площадку/страницу альбома (YouTube/Spotify), если нашлась.
  url         String?
  songs       Song[]
  createdAt   DateTime  @default(now())

  @@unique([performerId, title])
}

enum AlbumType {
  ALBUM
  EP
  SINGLE
}

model Song {
  id          String    @id @default(cuid())
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  albumId     String?
  album       Album?    @relation(fields: [albumId], references: [id], onDelete: SetNull)
  title       String
  // Пояснение из источника: «(with SIZZY)», название OST и т.п.
  note        String?
  year        Int?
  // Ссылка на площадку/клип, если появится источник.
  url         String?
  createdAt   DateTime  @default(now())

  @@index([performerId])
  @@index([albumId])
}

// A talent/management agency. Performers optionally belong to one or more
// (see PerformerAgency); the agency's own roster, description, and
// (later) logo make it a browsable entity in its own right rather than
// just a free-text label.
model Agency {
  id          String            @id @default(cuid())
  name        String            @unique
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug        String?           @unique
  logoUrl     String?
  description String?
  // Страница-источник (Wikipedia/fandom/сайт агентства/TMDB) — блок
  // «Источники»; проставляется импортёрами, у созданных руками null.
  sourceUrl   String?
  performers  PerformerAgency[]
  dramas      Drama[]
  dramaLinks  DramaAgency[]
  favoritedBy FavoriteAgency[]
  links       AgencyLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Переводы уникальных текстов: { "ru": { "<поле>": "…" } }. Какие
  /// поля переводимы — объявлено в src/lib/entityTranslations.ts, оттуда
  /// же берут список и форма админки, и читалка. Пусто — показывается
  /// оригинал.
  translations Json?
}

// Ссылки агентства — соцсети и сайт (правка владельца 2026-09-05).
// Та же форма, что у PerformerLink/LocationLink: свободная подпись,
// соцсети на странице узнаются по адресу (detectSocialPlatform).
model AgencyLink {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  label    String
  url      String

  @@index([agencyId])
}

// A performer<->agency association — many-to-many since a performer can
// be signed to more than one studio at once (a co-produced drama's cast
// may formally belong to a different studio than the one that produced
// it) or move between agencies over time. No current/past status field
// yet — every row just means "this performer is associated with this
// agency"; deliberately left simple until that distinction is needed.
model PerformerAgency {
  performerId String
  agencyId    String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([performerId, agencyId])
  @@index([agencyId])
}

// A member-actor of a band (e.g. an idol/actor who's also in a group).
// Bands don't get pairings or dramas of their own — those stay per-member.
model BandMember {
  bandId      String
  performerId String
  band        Performer @relation("BandMembers", fields: [bandId], references: [id], onDelete: Cascade)
  performer   Performer @relation("MemberOfBands", fields: [performerId], references: [id], onDelete: Cascade)

  @@id([bandId, performerId])
  @@index([performerId])
}

// Чем ссылка является для страницы артиста. Соцсети отдельным видом не
// выделены: их узнают по адресу (detectSocialPlatform) и рисуют
// иконками, а вид нужен там, где по адресу не догадаться.
enum PerformerLinkKind {
  // Прочее: показывается кнопкой в блоке фактов, как было всегда.
  OTHER
  // Личный бренд артиста — марка одежды, кафе, косметика. Показывается
  // отдельным блоком под описанием: у бренда есть своё имя, и оно важнее
  // адреса, поэтому иконкой его не заменить.
  BRAND
}

// Arbitrary "extra info" links per performer — personal brand, café,
// social media, etc. Free-form label so the admin can add whatever's
// relevant without a schema change.
model PerformerLink {
  id          String            @id @default(cuid())
  performerId String
  label       String
  url         String
  kind        PerformerLinkKind @default(OTHER)
  /// Заголовок СВОЕГО блока ссылок (правка владельца 2026-09-15):
  /// «Питомцы» с инстаграмами кота и собаки, «Кафе» с заведением
  /// артиста. Устроено как личные бренды, но заголовок задаёт владелец,
  /// а не словарь. Пусто — обычная ссылка-кнопка в блоке фактов.
  /// Ссылки с одинаковым заголовком собираются в один блок.
  group       String?
  performer   Performer         @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@index([performerId])
}

// Лайнап конкретного дня фестиваля (см. EventOccurrence.lineup).
model OccurrenceLineup {
  occurrenceId String
  performerId  String
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  performer    Performer       @relation(fields: [performerId], references: [id], onDelete: Cascade)
  // Когда выступает — строкой, как на афише («16:00-16:45»). Не
  // датой-временем намеренно: источники дают диапазон текстом, у части
  // артистов время не объявлено вовсе, а витрине хватает первого
  // «ЧЧ:ММ» из строки, чтобы выстроить день по порядку (правка
  // владельца 2026-09-06, расписание фестиваля по сценам).
  timeText     String?
  // Сцена фестиваля («Monster Stage»): в один час на разных сценах
  // играют разные артисты, и без неё расписание дня читается неверно.
  stage        String?

  @@id([occurrenceId, performerId])
  @@index([performerId])
}

model EventPerformer {
  eventId     String
  performerId String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@id([eventId, performerId])
  @@index([performerId])
}

// Новелла-первоисточник: многие лакорны — экранизации веб-новелл.
// Ссылки — где почитать/купить/скачать (свободный label+url).
model Novel {
  id             String      @id @default(cuid())
  title          String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts).
  slug           String?     @unique
  author         String?
  coverUrl       String?
  description    String?
  // Поля импорта с Фикбука (см. ficbook-import в admin/novels):
  // автор оригинала (для переводов), теги-бейджи (Слэш, Перевод, NC-17,
  // Завершён) вместе с «Метками», размер («N страниц, M слов»).
  originalAuthor String?
  tags           String[]    @default([])
  size           String?
  // Адрес страницы на ficbook.net, откуда взята запись (описание, автор,
  // теги, размер). Пишется импортом с Фикбука; показывается читателю в
  // блоке «Источники» — по образцу Drama.doramalandUrl. Уникален: одна
  // их страница — одна наша новелла.
  ficbookUrl     String?     @unique
  links          NovelLink[]
  dramas         Drama[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  reviews        Review[]
  comments       Comment[]

  /// Переводы уникальных текстов: { "ru": { "<поле>": "…" } }. Какие
  /// поля переводимы — объявлено в src/lib/entityTranslations.ts, оттуда
  /// же берут список и форма админки, и читалка. Пусто — показывается
  /// оригинал.
  translations Json?

  @@index([title])
}

model NovelLink {
  id      String @id @default(cuid())
  novelId String
  label   String
  url     String
  novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model Drama {
  id             String        @id @default(cuid())
  title          String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug           String?       @unique
  mydramalistUrl String?
  // Русские название и описание — с dorama.land (см.
  // features/doramaland-import.md). Русская версия сайта показывает их
  // вместо английских, когда они есть; «нет ру перевода» в админке —
  // это просто titleRu IS NULL.
  titleRu        String?
  synopsisRu     String?
  doramalandUrl  String?       @unique
  // Второй источник русских названий — asiapoisk.com (решение владельца
  // 2026-09-06): он покрывает то, до чего не дотянулся dorama.land, и
  // заодно знает страну, которой у трёх тысяч наших записей нет.
  // Уникален по той же причине: одна карточка — один наш сериал.
  asiapoiskUrl   String?       @unique
  posterUrl      String?
  synopsis       String?
  year           Int?
  status         DramaStatus?
  // TV channel/streaming platform it aired (or will air) on — TMDB
  // doesn't reliably carry this for Thai networks, so it comes from
  // agency Wikipedia imports instead (see wikipedia-agency-import.md).
  network        String?
  // Основное агентство (легаси, одно) + полный набор через DramaAgency:
  // у сериала бывает несколько студий-производителей.
  agencyId       String?
  agency         Agency?       @relation(fields: [agencyId], references: [id])
  agencies       DramaAgency[]
  // Первоисточник-новелла (если сериал — экранизация).
  novelId        String?
  novel          Novel?        @relation(fields: [novelId], references: [id])
  // The blscene.com "where was X filmed" page this drama was imported from,
  // if any — used to dedupe re-imports (its on-page title can differ from
  // the A-Z index's link text, so title matching alone isn't reliable).
  blsceneUrl     String?       @unique
  // TMDB TV show id, set once imported/matched from TMDB — see
  // tmdb-import.md. Same dedupe role as blsceneUrl, for a different source.
  tmdbId         String?       @unique

  // Данные со страницы MyDramaList (см. mydramalist-import.md):
  // блок Details + рейтинг. mdlSyncedAt — отметка последнего прохода
  // scripts/mdl-sync-dramas.ts (для резюма больших прогонов).
  nativeTitle   String?
  alsoKnownAs   String?
  director      String?
  screenwriter  String?
  genres        String[]  @default([])
  tags          String[]  @default([])
  episodes      Int?
  airedFrom     DateTime?
  airedTo       DateTime?
  airedOn       String?
  duration      String?
  contentRating String?
  // Страна и тип со страницы MDL («Thailand», «Drama»/«Movie»/«Special»).
  // Свободным текстом, а не перечислением: словарь у MDL свой и он
  // меняется, а жёсткий enum ронял бы импорт на каждом новом значении.
  country       String?
  // Тип записи как на MyDramaList: "Drama" | "Movie" | "TV Show" |
  // "TV Program"… По умолчанию — сериал (решение владельца 2026-09-16,
  // миграция 20260916T01): запись без типа — сериал, фильмы и шоу
  // размечены импортом явно. Импорт MDL при пустом типе с карточки
  // тоже пишет "Drama" (см. mdlDramaImport.ts).
  type          String?   @default("Drama")
  mdlScore      Float?
  mdlSyncedAt   DateTime?
  // Страница-источник на MyDramaList. Хранится, чтобы сериал можно было
  // переимпортировать позже: сама по себе ссылка не выводится из
  // названия — в ней числовой id. Заодно ключ дедупликации, как
  // blsceneUrl и tmdbId для своих источников.
  mdlUrl        String?   @unique
  // «Обновлять по расписанию». Отдельный флаг, а не «есть mdlUrl»:
  // ссылка есть у всего импортированного (тысячи записей), а ночью
  // обходить нужно только то, что ещё выходит и потому меняется.
  mdlAutoUpdate Boolean   @default(false)

  // Связанные тайтлы из блока Related Content (сиквелы, uncut-версии,
  // общая вселенная) — направленная связь с подписью отношения.
  relatedFrom DramaRelation[] @relation("RelatedFrom")
  relatedTo   DramaRelation[] @relation("RelatedTo")

  performers     PerformerDrama[]
  episodeWatches EpisodeWatch[]
  watchStatuses  DramaWatchStatus[]
  mdlRequests    MdlDramaRequest[]
  episodeList    DramaEpisode[]
  events         Event[]
  locations      DramaLocation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reviews   Review[]
  comments  Comment[]

  @@index([title])
  // Поля фильтров каталога (catalogFilters.ts): year — диапазон и
  // дефолтная сортировка, country/type/status/network — in-фильтры.
  @@index([year])
  @@index([status])
  @@index([country])
  @@index([type])
  @@index([network])
  // Гостевой список /dramas: «свежие по дате эфира» (order by desc,
  // airedFrom not null, take 60).
  @@index([airedFrom])
  @@index([agencyId])
  @@index([novelId])
}

// «Related Content» с MyDramaList: drama → related с подписью
// («Thai shared universe», «Thai compilation», «sequel» и т.п.).
// Сериал ↔ студии: many-to-many, как PerformerAgency у исполнителей.
model DramaAgency {
  dramaId  String
  agencyId String
  drama    Drama  @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@id([dramaId, agencyId])
  @@index([agencyId])
}

model DramaRelation {
  id        String  @id @default(cuid())
  dramaId   String
  relatedId String
  relation  String?
  drama     Drama   @relation("RelatedFrom", fields: [dramaId], references: [id], onDelete: Cascade)
  related   Drama   @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([dramaId, relatedId])
  @@index([relatedId])
}

// TMDB's own TV status vocabulary — whether a show has finished airing or
// not, distinct from a user's personal WatchStatus above.
enum DramaStatus {
  RETURNING_SERIES
  PLANNED
  IN_PRODUCTION
  ENDED
  CANCELED
  PILOT
}

// A real-world filming location (café, park, venue…) tied to one or more
// dramas. Kept its own entity (not a free-text field) so it's browsable and
// so users can track which ones they've actually visited.
// Категория места. Список закрытый: по нему строятся фильтры и иконки,
// а свободный текст в них превращается в кашу из синонимов.
enum LocationCategory {
  CAFE
  RESTAURANT
  SHOP
  MALL
  HOTEL
  PHOTO_SPOT
  LANDMARK
  PARK
  TRANSPORT
  OTHER
}

model Location {
  id              String              @id @default(cuid())
  name            String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug            String?             @unique
  description     String?
  // Откуда взята локация — блок «Источники» на её странице (см.
  // features/locations.md). Каталожные локации пришли с blscene.com, и
  // атрибуция там обязательна; у мест, созданных пользователями
  // (createdByUserId), источника нет.
  sourceUrl       String?
  // Что это за место: кафе, магазин, отель… Нужна для фильтров в
  // списках мест и в «Что посетить» внутри поездки, и для иконок на
  // карте. Правится в админке; у части каталожных локаций пустая.
  category        LocationCategory?
  // Инстаграм заведения, сайт, канал — фандом чаще всего находит места
  // именно по инстаграму.
  links           LocationLink[]
  photoUrl        String?
  latitude        Float?
  longitude       Float?
  // Место, созданное пользователем для своих списков/поездок (а не
  // импортированное из каталога дорам): в общий каталог/карту/админку
  // такие не попадают — видны только через списки и поиск автора.
  createdByUserId String?
  createdBy       User?               @relation("UserCreatedLocations", fields: [createdByUserId], references: [id], onDelete: Cascade)
  dramas          DramaLocation[]
  visitedBy       LocationVisit[]
  events          Event[]
  listItems       PlaceListItem[]
  tripPlaces      TripPlace[]
  personalEvents  TripPersonalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Переводы уникальных текстов: { "ru": { "<поле>": "…" } }. Какие
  /// поля переводимы — объявлено в src/lib/entityTranslations.ts, оттуда
  /// же берут список и форма админки, и читалка. Пусто — показывается
  /// оригинал.
  translations Json?

  @@index([name])
  @@index([createdByUserId])
}

model DramaLocation {
  dramaId    String
  locationId String
  drama      Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  // Когда место привязали к сериалу — по этому полю строится лента «что
  // нового» на главной. У самой Location даты мало: одно и то же кафе
  // переиспользуется разными сериалами, и «новым» оно становится в день
  // привязки, а не заведения.
  createdAt  DateTime @default(now())

  @@id([dramaId, locationId])
  @@index([locationId])
  @@index([createdAt])
}

// A user marking a location as visited — analogous to EventAttendance but
// for locations, with no "favorite" concept of its own.
model LocationVisit {
  userId     String
  locationId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, locationId])
  @@index([locationId])
}

enum WatchStatus {
  WATCHING
  COMPLETED
  ON_HOLD
  PLAN_TO_WATCH
  DROPPED
}

// Per-user watch-progress tracking for a drama (MyDramaList-style status).
// This is the only per-user "how do I feel about this drama" signal —
// there's deliberately no separate drama favorite/heart, unlike
// performers/events/agencies (see docs/features/social.md).
/**
 * Расписание серий: какая серия на какое число.
 * Отдельными строками, а не вычислением «airedFrom + неделя × номер»:
 * у сериалов бывают перерывы, сдвоенные показы и спецвыпуски, и
 * посчитанная дата врала бы ровно там, где на неё смотрят — «выходит ли
 * сегодня». Даты приходят со страницы /episodes на MyDramaList.
 */
model DramaEpisode {
  id      String    @id @default(cuid())
  dramaId String
  drama   Drama     @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  number  Int
  // null — дату ещё не объявили: у выходящего сериала хвост расписания
  // обычно пустой, и это не то же самое, что «серии нет».
  airDate DateTime?
  title   String?

  notifications EpisodeNotification[]

  @@unique([dramaId, number])
  // Под запрос «что выходит сегодня» на главной.
  @@index([airDate])
}

model DramaWatchStatus {
  userId          String
  dramaId         String
  status          WatchStatus
  // СВОЯ оценка сериалу, 1-10 (АА2). Отдельно от отзыва: оценку ставят
  // почти все, а отзыв пишут единицы, и раньше поставить балл без
  // текста было негде. `Drama.mdlScore` — это, наоборот, ОБЩАЯ оценка
  // с MyDramaList, она про весь мир, а не про тебя.
  //
  // Живёт у статуса просмотра, а не отдельной таблицей: оценка без
  // отношения к сериалу не бывает, а строка статуса как раз и есть
  // «мои отношения с этим сериалом».
  rating          Float?
  // На какой серии человек остановился. null — не отмечал: это не то же
  // самое, что 0 («начал и не посмотрел ни одной»), и прогресс-бар в
  // первом случае не рисуется вовсе. Общее число серий берётся из
  // Drama.episodes и тоже бывает неизвестным — тогда счётчик работает
  // без верхней границы.
  episodesWatched Int?
  // Сколько раз пересматривали — СВЕРХ первого просмотра: 0 — смотрели
  // один раз (или ещё смотрят), 2 — всего три просмотра. Так число не
  // требует бэкфилла и не врёт про тех, кто ничего не отмечал.
  //
  // Одним счётчиком, а не таблицей заходов с датами (решение владельца
  // 2026-09-09): даты каждого просмотра пришлось бы вводить руками, а их
  // не помнят. Считается в серии и часы у экрана, но НЕ в «досмотрено
  // сериалов»: там счёт разным тайтлам (см. lib/userStats.ts).
  rewatchCount    Int         @default(0)
  // Когда досмотрели: ставится при переходе в COMPLETED, руками не
  // правится. null у старых строк — честное «не знаем», выдуманной даты
  // тут не будет (итоги года считают только заполненные).
  completedAt     DateTime?
  // Колокольчик «уведомлять о новых сериях» на странице сериала (З1):
  // подписка per-сериал. Включается сам при переходе в «Смотрю сейчас»
  // и гаснет при уходе из него; руками переключается независимо от
  // статуса. Дефолт false: строка может завестись любым статусом.
  notifyEpisodes  Boolean     @default(false)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama           Drama       @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  updatedAt       DateTime    @updatedAt

  @@id([userId, dramaId])
  @@index([dramaId])
}

model PerformerDrama {
  performerId String
  dramaId     String
  role        String? // character name, optional
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  drama       Drama     @relation(fields: [dramaId], references: [id], onDelete: Cascade)

  @@id([performerId, dramaId])
  @@index([dramaId])
}

// A named pairing ("ship") of two performers, selectable on events instead
// of / alongside individual performers.
model Pairing {
  id           String         @id @default(cuid())
  name         String?
  status       PairingStatus  @default(CURRENT)
  performerAId String
  performerBId String
  performerA   Performer      @relation("PairingA", fields: [performerAId], references: [id], onDelete: Cascade)
  performerB   Performer      @relation("PairingB", fields: [performerBId], references: [id], onDelete: Cascade)
  events       EventPairing[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  mascots   MascotOwner[]

  @@unique([performerAId, performerBId])
  @@index([performerBId])
}

enum PairingStatus {
  CURRENT
  PAST
}

model EventPairing {
  eventId   String
  pairingId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pairing   Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@id([eventId, pairingId])
  @@index([pairingId])
}

// ---------- User accounts (separate from the single admin password) ----------

model User {
  id                       String               @id @default(cuid())
  // Both nullable because a Telegram-auth account has neither — an
  // email+password account always has both (enforced in the signup
  // action, not the schema).
  // Ник: публичная часть ссылки (/users/keetmine), уникален и виден
  // всем. Предзаполняется на шаге после регистрации из Telegram-username
  // или части почты — так человек не застревает на форме, — но его
  // можно изменить.
  username                 String?              @unique
  email                    String?              @unique
  passwordHash             String?
  // Роль админа: доступ к /admin без отдельного пароля — обычная
  // сессия пользователя + этот флаг (см. requireAdmin в lib/auth.ts).
  isAdmin                  Boolean              @default(false)
  // Менеджер каталога: полный доступ к разделам «Каталог» админки
  // (события, исполнители, сериалы, новеллы, локации, импорты), но без
  // пользователей, финансов, рассылок и настроек — это только админ.
  isManager                Boolean              @default(false)
  auditLogs                AuditLog[]
  notifications            Notification[]       @relation("UserNotifications")
  performersSeen           PerformerSeen[]
  eventSeenPerformers      EventSeenPerformer[]
  eventMaybes              EventMaybe[]
  // Что дублировать в Telegram (уведомления на сайте приходят всегда).
  // Раньше набор поводов был зашит в код и одинаков для всех.
  tgNotifyInvites          Boolean              @default(true)
  tgNotifyFriends          Boolean              @default(true)
  tgNotifyReplies          Boolean              @default(true)
  tgNotifyEvents           Boolean              @default(true)
  // Дни рождения избранных артистов (З3). Свой переключатель, а не
  // общий с событиями: повод ежедневный и нравится далеко не всем, а
  // «друзья идут на события» человек может хотеть оставить.
  tgNotifyBirthdays        Boolean              @default(true)
  // Новые серии отмеченных «Смотрю сейчас» сериалов (З1). Свой
  // переключатель по той же причине, что и у дней рождения: у
  // выходящего сериала повод еженедельный, а то и чаще.
  tgNotifyEpisodes         Boolean              @default(true)
  // Сообщества: приглашения и решения по заявкам. Темы обсуждений сюда
  // не идут — их слишком много.
  tgNotifyCommunities      Boolean              @default(true)
  // Новости проекта из /admin/broadcast — раньше рассылка игнорировала
  // настройки и уходила всем с привязанным Telegram.
  tgNotifyBroadcast        Boolean              @default(true)
  // Недельный дайджест «Ваша неделя» по воскресеньям (премиум). Свой
  // переключатель: человек может хотеть напоминания о продажах, но не
  // хотеть воскресное письмо. Колонка заведена миграцией 20260910T00.
  tgNotifyDigest           Boolean              @default(true)
  // Обратный отсчёт до поездки (АА9, правка владельца 2026-09-23):
  // последний месяц перед поездкой — по сообщению каждое утро. Свой
  // переключатель: повод ежедневный и на целый месяц, а приглашения в
  // поездки (tgNotifyInvites) человек может хотеть оставить.
  tgNotifyTrips            Boolean              @default(true)
  // Тур по интерфейсу для новичков: показывается один раз после
  // регистрации, перезапускается кнопкой в настройках.
  tourCompletedAt          DateTime?
  // Когда человек закрыл предложение привязать Telegram (АА-правка
  // владельца 2026-09-06). Показываем его ОДИН раз и только тем, кто
  // зарегистрировался почтой: без телеграма уведомления о новых сериях,
  // друзьях и препродажах идут только на сайт, и человек про них не
  // знает. Закрыл — больше не спрашиваем, привязка остаётся в
  // настройках.
  telegramPromptedAt       DateTime?
  // Мягкое удаление: запись остаётся (её связи — комментарии, отзывы,
  // участие в поездках — иначе исчезли бы каскадом), но аккаунт нигде не
  // показывается и войти в него нельзя. Уникальные поля при удалении
  // освобождаются — иначе почта и Telegram остались бы занятыми навсегда.
  deletedAt                DateTime?
  actedNotifications       Notification[]       @relation("NotificationActor")
  // Google-аккаунт (OAuth): sub из id_token. Set = "может войти через Google".
  googleId                 String?              @unique
  name                     String?
  photoUrl                 String?
  // Широкая картинка над левой колонкой профиля — косметика для
  // подписчиков (аудит 2026-09, раздел 8). Отдельно от photoUrl: то
  // аватар 3:4, это баннер. Ставить может подписчик, ВИДЯТ все, включая
  // гостей: иначе профиль ломался бы визуально в день окончания
  // подписки. Колонка заведена миграцией 20260910T00.
  coverUrl                 String?
  // Telegram user id from the Login Widget (doubles as the DM chat id
  // for bot notifications). Set = "can log in via Telegram".
  telegramId               String?              @unique
  telegramUsername         String?
  // Подписка действует, пока premiumUntil в будущем (null — не было).
  // Продлевается из админки (+1 месяц) или оплатой; гейты проверяют
  // через isPremiumActive() (src/lib/premium.ts).
  premiumUntil             DateTime?
  // Для какого premiumUntil уже отправлено телеграм-напоминание об
  // истечении — дедуп напоминалки «подписка кончается через 3 дня».
  premiumExpiryNotifiedFor DateTime?
  // Бессрочная подписка: админ выдаёт друзьям и команде, чтобы не
  // продлевать каждый месяц. Пока true — подписка активна независимо от
  // premiumUntil, напоминание об истечении не шлётся. Снятие флага
  // возвращает обычный срок: premiumUntil при выдаче не трогается.
  premiumLifetime          Boolean              @default(false)
  // Opaque token for the read-only "subscribe to my calendar" ICS feed —
  // generated on first request since calendar apps fetch it without a
  // session cookie, so it needs its own unguessable credential.
  icsToken                 String?              @unique
  // Таймзона для «времени в скобках» рядом с тайским (дефолт — МСК).
  timezone                 String               @default("Europe/Moscow")
  // Когда человек последний раз что-то делал на сайте. Обновляется не
  // на каждый запрос, а раз в несколько минут (см. lib/lastSeen.ts):
  // запись на каждый чих утроила бы количество записей в базу ради
  // поля, которое смотрят раз в неделю в админке.
  lastSeenAt               DateTime?
  // Язык, выбранный человеком явно. null — не выбирал: тогда решает
  // язык браузера. Нужен помимо куки для того, что уходит человеку ВНЕ
  // запроса — уведомления в Telegram, название календарной подписки, —
  // там браузера с его кукой рядом нет. Куку это поле не заменяет:
  // proxy ходит на каждый запрос и в базу не лезет, поэтому язык из
  // профиля кладётся в куку при входе.
  locale                   String?
  // Профиль: заполняется по желанию на шаге после регистрации и в
  // настройках.
  country                  String?
  gender                   String?
  birthDate                DateTime?
  bio                      String?
  createdAt                DateTime             @default(now())

  sessions                     UserSession[]
  favoritePerformers           FavoritePerformer[]
  favoriteEvents               FavoriteEvent[]
  favoriteAgencies             FavoriteAgency[]
  eventAttendances             EventAttendance[]
  personalEventAttendances     TripPersonalEventAttendance[]
  personalEventSeen            TripPersonalEventSeen[]
  dramaWatchStatuses           DramaWatchStatus[]
  visitedLocations             LocationVisit[]
  trips                        Trip[]
  telegramNotifications        TelegramNotification[]
  telegramPresaleNotifications TelegramPresaleNotification[]
  birthdayNotifications        BirthdayNotification[]
  tripCountdowns               TripCountdownNotification[]
  mdlDramaRequests             MdlDramaRequestUser[]
  episodeNotifications         EpisodeNotification[]
  performerEventNotifications  PerformerEventNotification[]
  friendMutes                  FriendNotificationMute[]      @relation("MuteOwner")
  mutedByFriends               FriendNotificationMute[]      @relation("MuteTarget")
  eventNotes                   EventNote[]
  achievements                 UserAchievement[]
  placeLists                   PlaceList[]
  performerLists               PerformerList[]
  tripMemberships              TripMember[]
  // Свои даты в общих поездках (АА17).
  tripStays                    TripStay[]
  bookingParticipations        TripBookingParticipant[]
  reviews                      Review[]
  comments                     Comment[]
  commentLikes                 CommentLike[]
  passwordResetTokens          PasswordResetToken[]
  createdLocations             Location[]                    @relation("UserCreatedLocations")
  // Приватность публичного профиля. Друзья видят всё всегда.
  // hideProfileActivity — мастер-выключатель (чужие видят только
  // имя/фото); остальные — точечные блоки при открытом профиле.
  hideProfileActivity          Boolean                       @default(false)
  hideAchievements             Boolean                       @default(false)
  hideFavoritePerformers       Boolean                       @default(false)
  hideVisitedPlaces            Boolean                       @default(false)

  feedbacks              Feedback[]
  reports                Report[]
  payments               Payment[]
  friendRequestsSent     Friendship[]      @relation("FriendRequester")
  friendRequestsReceived Friendship[]      @relation("FriendAddressee")
  redeemedPromoCodes     PromoCode[]       @relation("PromoRedeemer")
  eventTickets           EventTicket[]
  // Блокировка (решение владельца 2026-09-09). Мягкое удаление
  // (`deletedAt`) — действие самого человека, а это инструмент
  // владельца сайта: забаненный не входит и не пишет, но написанное им
  // остаётся — массовое исчезновение чужих реплик рвёт разговоры.
  // Кто привёл (реферальная ссылка /signup?ref=…). SetNull при удалении
  // пригласившего: приглашённый — не его собственность.
  referredById           String?
  referredBy             User?             @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]            @relation("Referrals")
  episodeWatches         EpisodeWatch[]
  bannedAt               DateTime?
  /// Причина видна только админу: человеку показываем факт, а не текст.
  banReason              String?
  bannedById             String?
  bannedBy               User?             @relation("UserBans", fields: [bannedById], references: [id], onDelete: SetNull)
  bannedUsers            User[]            @relation("UserBans")
  ownedCommunities       Community[]       @relation("CommunityOwner")
  communityMemberships   CommunityMember[]
  communityInvites       CommunityInvite[] @relation("CommunityInviteTo")
  communityInvitesSent   CommunityInvite[] @relation("CommunityInviteBy")
  communityPosts         CommunityPost[]
  createdEvents          Event[]           @relation("EventAuthor")
  tripExpenses           TripExpense[]
}

// A user's planned trip (to Thailand) — a named date range; the trip page
// shows every event occurrence falling inside it, so "what's happening
// while I'm there" is one click instead of a manual date-range filter.
model Trip {
  id             String              @id @default(cuid())
  userId         String
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug           String?             @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  startDate      DateTime
  endDate        DateTime
  // Кто может открыть страницу поездки: PRIVATE — только владелец,
  // FRIENDS — владелец и его принятые друзья, PUBLIC — любой залогиненный.
  // Личные события поездки при этом видны только владельцу всегда.
  visibility     TripVisibility      @default(PRIVATE)
  createdAt      DateTime            @default(now())
  /// Поездка, собранная сообществом: показывается вкладкой в самом
  /// сообществе. У личных поездок тут null.
  communityId    String?
  community      Community?          @relation(fields: [communityId], references: [id], onDelete: SetNull)
  personalEvents TripPersonalEvent[]
  placeLists     TripPlaceList[]
  places         TripPlace[]
  todos          TripTodo[]
  members        TripMember[]
  // Свои даты участников — см. TripStay.
  stays          TripStay[]
  bookings       TripBooking[]
  expenses       TripExpense[]
  countdowns     TripCountdownNotification[]

  @@index([userId])
}

enum TripTodoKind {
  TODO
  PACKING
  SHOPPING
}

enum TripVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

// A user's own private entry inside a trip (dinner reservation, museum
// day, flight) — rendered chronologically among the public events of the
// trip's date range, visible only to the trip's owner. Deliberately much
// simpler than Event: one date/time, free-text note, no venue entity or
// performers.
// Со-путешественник: полноценный доступ к поездке (видит всё, вносит
// события/дела). Права на чужие записи — по editableByOthers записи;
// владелец поездки может всё. Добавление — через инвайт: PENDING до
// принятия, участником считается только ACCEPTED.
enum TripMemberStatus {
  PENDING
  ACCEPTED
}

/**
 * Свои даты участника в общей поездке (АА17): подруги едут вместе, но
 * летят разными рейсами — одна с 18 октября по 2 ноября, другая с 22 по
 * 6. Поездка при этом ОДНА: общий отель, общий план, одна страница;
 * разъезжается только присутствие.
 * Строки нет — «как вся поездка», поэтому ничего не надо ни
 * бэкфиллить, ни заводить владельцу; свои даты он задаёт так же, как
 * участник, и отдельной строкой в TripMember для этого не становится.
 */
model TripStay {
  tripId    String
  userId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  @@id([tripId, userId])
  @@index([userId])
}

model TripMember {
  tripId    String
  userId    String
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    TripMemberStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@id([tripId, userId])
  @@index([userId])
}

model TripPersonalEvent {
  id               String                        @id @default(cuid())
  tripId           String
  trip             Trip                          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title            String
  note             String?
  startsAt         DateTime
  // Личное событие можно привязать к известной локации — карточка
  // показывает место со ссылкой, оно попадает на карту поездки.
  locationId       String?
  location         Location?                     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  // Совместные поездки: кто создал запись (null — владелец поездки,
  // легаси) и можно ли другим участникам её править/удалять.
  createdById      String?
  editableByOthers Boolean                       @default(false)
  // Приватная запись — видна только автору, даже другим участникам.
  // Историческое поле, его заменяет visibility.
  isPrivate        Boolean                       @default(false)
  visibility       TripItemVisibility            @default(PARTICIPANTS)
  // Дни события (правка владельца 2026-09-18: «на личные даты тоже
  // несколько дней и на каждый день свой актёрский состав»). У каждого
  // дня свои дата, время и артисты; startsAt выше — первый день,
  // держится в синхроне при сохранении (по нему сортировка, главная и
  // расходы). Артисты дня после его даты попадают в «видел(а) вживую»
  // отметившимся — см. lib/userStats.ts. Запись без дней (старые
  // сиды тестов) лента считает однодневной по startsAt.
  days             TripPersonalEventDay[]
  // Отметки «я там буду» участников — см. TripPersonalEventAttendance.
  attendances      TripPersonalEventAttendance[]
  // Показывать в блоке «Вы идёте» на главной (Ж11) — по желанию:
  // перелёты и брони на главной не нужны, а встреча с друзьями — да.
  showOnHome       Boolean                       @default(false)
  // Картинка к записи (скан билета, скрин брони, афиша) — приватная,
  // как и сама запись: лежит в private-uploads/, раздаётся через
  // /files/personal/… с проверкой участия в поездке.
  imageUrl         String?
  // Ссылка «куда посмотреть»: бронь на сайте площадки, страница
  // мероприятия, точка на карте. Только http(s) — проверка в
  // parsePersonalEventForm. Отдельно от imageUrl: там наш приватный
  // файл, тут чужой адрес.
  url              String?
  createdAt        DateTime                      @default(now())

  /// Цена записи — она же строка в расходах поездки (правка владельца
  /// 2026-09-16). Минорные единицы, как у TripExpense; валюта своя у
  /// каждой записи: перелёт часто в рублях, отель в батах.
  /// Отдельной траты при заполнении НЕ создаётся: вкладка расходов
  /// читает цену отсюда, а копия пришлось бы держать в синхроне.
  priceMinor    Int?
  priceCurrency TripCurrency?

  @@index([tripId])
  @@index([locationId])
}

// Пользовательская подборка локаций («где вкусная еда», «кафешки из
// дорам») — с той же моделью видимости, что у поездок. Показывается
// списком и на карте; прикрепляется к поездкам (TripPlaceList).
// Кастомный список актёров пользователя («пил пиво», «видела вживую»…)
// — аналог PlaceList, та же видимость и слаг название+код.
model PerformerList {
  id          String              @id @default(cuid())
  userId      String
  slug        String?             @unique
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  TripVisibility      @default(PRIVATE)
  items       PerformerListItem[]
  createdAt   DateTime            @default(now())

  @@index([userId])
}

model PerformerListItem {
  listId      String
  performerId String
  note        String?
  position    Int           @default(0)
  list        PerformerList @relation(fields: [listId], references: [id], onDelete: Cascade)
  performer   Performer     @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@id([listId, performerId])
  @@index([performerId])
}

model PlaceList {
  id          String          @id @default(cuid())
  userId      String
  /// Список сообщества: «куда сходить в Минске» ведёт всё сообщество, а
  /// не один человек. userId при этом остаётся — это тот, кто завёл.
  communityId String?
  community   Community?      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  // Публичный слаг URL (см. src/lib/slug.ts + slugHelpers.ts):
  // каталожные — из названия с нумерацией при совпадении, поездки и
  // списки — название + короткий код. null — слаг не сгенерирован
  // (например, тайское название), ссылки откатываются на id.
  slug        String?         @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  visibility  TripVisibility  @default(PRIVATE)
  items       PlaceListItem[]
  trips       TripPlaceList[]
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model PlaceListItem {
  listId     String
  locationId String
  note       String?
  // Ручной порядок в списке (кнопки вверх/вниз); сортировка
  // (position, createdAt) — у старых записей position 0.
  position   Int       @default(0)
  list       PlaceList @relation(fields: [listId], references: [id], onDelete: Cascade)
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@id([listId, locationId])
  @@index([locationId])
}

// Прикрепление целого списка мест к поездке.
// Туду-лист поездки: пункт с чекбоксом и (необязательно) датой —
// датированные дела попадают в хронологию «Мой план».
// Кто видит отдельную запись внутри поездки — дело, бронь, личное
// событие. Отдельно от видимости самой поездки: поездку можно открыть
// друзьям, а бронь отеля с адресом и номером — нет.
//
// Заводится рядом с существующим isPrivate, а не вместо него: сначала
// поле появляется и заполняется, потом код переходит на него, и только
// после этого isPrivate убирается. Обратный порядок уронил бы прод в
// промежутке между миграцией и выкаткой кода.
enum TripItemVisibility {
  // Только автор записи.
  PRIVATE
  // Участники поездки — так ведут себя записи, созданные до этого поля.
  PARTICIPANTS
  // Друзья автора, если сама поездка им видна.
  FRIENDS
  // Все, кому видна поездка.
  PUBLIC
}

model TripTodo {
  id               String             @id @default(cuid())
  tripId           String
  trip             Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text             String
  done             Boolean            @default(false)
  // Какой это список: дела, чемодан («что взять») или покупки («что
  // купить в Таиланде») — АА10/АА11. Отдельными моделями они не стали
  // намеренно: галочка «готово», дата, видимость, автор и право правки
  // у всех трёх одинаковые, и три копии этой механики разъехались бы с
  // первой же правкой. Старые записи — дела.
  kind             TripTodoKind       @default(TODO)
  date             DateTime?
  // Совместные поездки: автор и право правки другими участниками.
  createdById      String?
  editableByOthers Boolean            @default(false)
  // Приватное дело — видно только автору. Историческое поле, его
  // заменяет visibility (см. комментарий у TripItemVisibility).
  isPrivate        Boolean            @default(false)
  visibility       TripItemVisibility @default(PARTICIPANTS)
  // Время указано? (date хранит и время; без флага «00:00» неотличим
  // от «без времени»).
  hasTime          Boolean            @default(false)
  createdAt        DateTime           @default(now())

  /// Цена пункта ПОКУПОК (у дел и чемодана поля в форме нет).
  /// В расходы поездки попадает только купленное (`done`): список
  /// покупок — это хотелки, и неотмеченный пункт остаётся планом.
  priceMinor    Int?
  priceCurrency TripCurrency?

  /// Описание и ссылка — как у личного события поездки. В форме
  /// показываются только у ДЕЛ: у «взять переходник» описания не бывает.
  /// Ссылка сохраняется только http(s) — мусор молча отбрасывается, и
  /// запись из-за него не теряется.
  note String?
  url  String?

  @@index([tripId])
}

model TripPlaceList {
  tripId String
  listId String
  trip   Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  list   PlaceList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([tripId, listId])
  @@index([listId])
}

// Отдельное важное место, добавленное прямо в поездку (без списка).
model TripPlace {
  tripId     String
  locationId String
  note       String?
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([tripId, locationId])
  @@index([locationId])
}

// Дедуп пресейл-напоминаний: одно на (юзер, событие) — сама препродажа
// у события одна (Event.presaleAt), в отличие от дат выступлений.
/**
 * Кому про чей день рождения уже сказали в этом году (З3).
 * Год в ключе, а не дата: планировщик просыпается каждые полчаса, и без
 * отметки человек получал бы поздравление двадцать раз за сутки. На
 * следующий год та же пара сработает снова — потому и год, а не просто
 * пара (userId, performerId).
 */
/// Дедуп ежедневного отсчёта до поездки: одно сообщение человеку на
/// поездку в календарный день (`day` — YYYY-MM-DD по времени сервера).
/// Ключ по дню, а не по «сколько осталось»: сдвинутая поездка проходит
/// одни и те же числа заново, и по ним отметка молчала бы зря.
model TripCountdownNotification {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day       String
  createdAt DateTime @default(now())

  @@id([userId, tripId, day])
  @@index([tripId])
}

model BirthdayNotification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  year        Int
  createdAt   DateTime  @default(now())

  @@unique([userId, performerId, year])
  @@index([performerId])
}

// Дедуп уведомлений «вышла серия» (З1): одна серия — одно уведомление
// человеку, сколько бы раз планировщик ни просыпался. Уникальный ключ
// заодно судит гонку двух пересёкшихся тиков — как у дней рождения.
model EpisodeNotification {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   DramaEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, episodeId])
  @@index([episodeId])
}

// Дедуп «у избранного артиста новое событие»: одно уведомление на пару
// (пользователь, событие) — сколько бы избранных артистов ни было в
// составе, сколько бы раз админ ни пересобрал состав правкой формы и
// когда бы к событию ни привязали ещё одного артиста. Отметка ставится
// ДО отправки, гонку двух вызовов судит уникальный ключ — как у серий.
model PerformerEventNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

// Состояние разговора с ботом (И7): по нему вебхук решает, отвечать ли
// автоподтверждением. Ключ — telegram chat id, НЕ наш userId: боту
// пишут и незарегистрированные. Записи не чистятся — их по одной на
// человека, когда-либо писавшего боту.
model TelegramChatState {
  chatId            String    @id
  // Когда человек последний раз писал боту — от этого считается
  // «тишина», после которой разговор считается новым.
  lastUserMessageAt DateTime
  // Когда админ последний раз отвечал: после ответа разговор живой, и
  // автоподтверждения молчат до следующей паузы.
  lastAdminReplyAt  DateTime?
  updatedAt         DateTime  @updatedAt
}

model TelegramPresaleNotification {
  userId  String
  eventId String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentAt  DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

// «Отписка» от уведомлений о конкретном друге: по умолчанию уведомления
// о всех друзьях включены, строка здесь их выключает (userId больше не
// получает «mutedFriend идёт на …»).
model FriendNotificationMute {
  userId        String
  mutedFriendId String
  user          User     @relation("MuteOwner", fields: [userId], references: [id], onDelete: Cascade)
  mutedFriend   User     @relation("MuteTarget", fields: [mutedFriendId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([userId, mutedFriendId])
  @@index([mutedFriendId])
}

// Заметка пользователя к событию — личная или видимая друзьям. Одна на
// (юзер, событие): редактируется, а не копится.
model EventNote {
  id         String         @id @default(cuid())
  userId     String
  eventId    String
  text       String
  visibility NoteVisibility @default(PERSONAL)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
}

enum NoteVisibility {
  PERSONAL
  FRIENDS
  // Видна со-путешественникам: участникам общих совместных поездок автора.
  TRIP
}

// Определения ачивок (Э2ф): раньше были зашиты в код, теперь редактируются
// в /admin/achievements. `metric` — ключ из фиксированного набора способов
// подсчёта (METRICS в src/lib/achievements.ts): само вычисление остаётся
// кодом, БД задаёт только «какая метрика и какой порог». Флаговые метрики
// («Дубль», «Марафон» и т.п.) держат threshold = 1.
/// Чья это ачивка. До сих пор все были личные; у сообществ появились
/// свои — их зарабатывают вместе, и висят они на странице сообщества,
/// а не в профиле (просьба владельца 2026-09-08).
enum AchievementScope {
  USER
  COMMUNITY
}

model Achievement {
  id        String           @id @default(cuid())
  key       String           @unique
  scope     AchievementScope @default(USER)
  emoji     String
  title     String
  hint      String
  metric    String
  threshold Int
  // enabled=false прячет ачивку отовсюду (кабинет, профиль, подсчёт
  // прогресса), но уже выданные UserAchievement-строки не трогает.
  enabled   Boolean          @default(true)
  sort      Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Разблокированные ачивки (Д2): условия считаются из данных на лету
// (src/lib/achievements.ts), строка фиксирует момент получения — для
// «новых» поздравлений в Telegram и стабильного порядка в профиле.
// `key` ссылается на Achievement.key НАМЕРЕННО без FK: удалённая из
// админки ачивка просто перестаёт показываться, а строка-факт остаётся.
/// Выданная ачивка СООБЩЕСТВА. Устроена как UserAchievement — связь по
/// ключу, а не по id: ключи стабильны, а строки Achievement
/// пересоздаются сидом.
model CommunityAchievement {
  communityId String
  key         String
  unlockedAt  DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([communityId, key])
}

model UserAchievement {
  userId     String
  key        String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

// Dedup ledger for Telegram event reminders — one row per (user,
// occurrence) that's already been messaged, so the periodic job never
// notifies twice about the same date of the same event.
model TelegramNotification {
  userId       String
  occurrenceId String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  sentAt       DateTime        @default(now())

  @@id([userId, occurrenceId])
  @@index([occurrenceId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Directed request row: requester -> addressee. status PENDING until the
// addressee accepts; an accepted row represents the friendship itself (no
// separate row needed on the other side — queries check both directions).
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Промокод подписки: одноразовый, даёт months месяцев премиума при
// активации (генерация в админке, активация на пейволле).
model PromoCode {
  code      String    @id
  months    Int       @default(1)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  usedById  String?
  usedBy    User?     @relation("PromoRedeemer", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([usedById])
}

model FavoritePerformer {
  userId      String
  performerId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([userId, performerId])
  @@index([performerId])
}

model FavoriteAgency {
  userId    String
  agencyId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, agencyId])
  @@index([agencyId])
}

model FavoriteEvent {
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

// «Я пойду» — теперь на КОНКРЕТНУЮ дату (occurrence), а не на событие
// целиком: у двухдневного концерта можно идти только на 25-е. eventId
// денормализован для выборок «идёт ли на событие вообще» (индикатор
// друзей, фильтры).
/**
 * Купленный билет — СВОЯ запись, а не поле на отметке «иду».
 * На отметке он жил и погибал вместе с ней: снял «иду» и вернул — билет
 * пропал; админ пересобрал даты события — каскад по occurrenceId унёс
 * отметки вместе с билетами. Файл при этом оставался на диске, но
 * доказать, чей он, было нечем — /files/tickets отвечал «не найдено»
 * (реальный случай на проде, 2026-08-28).
 * Привязка к дате — наводка, а не жизнь билета: пересоздали дату —
 * occurrenceId занулился, билет остался у события.
 */
model EventTicket {
  id                      String           @id @default(cuid())
  userId                  String
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId                 String
  event                   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceId            String?
  occurrence              EventOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  fileUrl                 String
  // Онлайн-бронирование (мест/бенефитов), которое у тайских событий
  // открывается после покупки билета в назначенное время. Владелец
  // билета записывает его сам. Время — тайское настенное в UTC-слоте,
  // как Event.presaleAt (см. lib/dates.ts); ссылка — только http(s).
  onlineBookingAt         DateTime?
  onlineBookingUrl        String?
  // Дедуп напоминания «через час откроется» (sendOnlineBookingReminders):
  // отметка ставится атомарно перед отправкой, а смена времени
  // бронирования сбрасывает её — новое время напоминается заново.
  onlineBookingNotifiedAt DateTime?
  createdAt               DateTime         @default(now())

  @@index([userId])
  @@index([eventId])
  @@index([occurrenceId])
  @@index([onlineBookingAt])
}

/**
 * «Возможно пойду» — кандидат на дату (правка владельца 2026-09-15).
 * Между сердечком («интересно вообще», на событие целиком) и «иду»
 * («решено»). Смысл — увидеть свои варианты в расписании поездки: в один
 * вечер два концерта, оба интересны, пойду на один. В общей афише они
 * терялись среди чужого.
 * ОТДЕЛЬНАЯ таблица, а не статус у EventAttendance: отметки «иду»
 * читаются в трёх десятках мест (статистика, ачивки, «видела вживую»,
 * уведомления друзьям, выгрузка в календарь), и любое пропущенное
 * превратило бы «может быть» в посещённое событие. Здесь же «возможно»
 * не считается НИГДЕ — это черновик планов.
 * Взаимоисключимо с «иду»: экшены снимают встречную отметку.
 */
model EventMaybe {
  userId       String
  occurrenceId String
  // Денормализовано, как в EventAttendance: выборки «есть ли кандидат
  // на событие вообще» не должны ходить через даты.
  eventId      String
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, occurrenceId])
  @@index([eventId])
  @@index([occurrenceId])
}

model EventAttendance {
  userId       String
  occurrenceId String
  eventId      String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // ЛЕГАСИ: билет переехал в EventTicket (см. выше) — здесь он погибал
  // вместе с отметкой. Колонка не читается и не пишется; данные
  // скопированы миграцией 20260828130000. Снести при следующей уборке.
  ticketUrl    String?
  createdAt    DateTime        @default(now())

  @@id([userId, occurrenceId])
  @@index([eventId])
  @@index([occurrenceId])
}

// Отзыв (оценка 1–10 + текст) к сериалу/новелле/событию — ровно одна из
// трёх ссылок задана. Один отзыв на юзера на объект: составные @@unique
// работают, т.к. NULL в Postgres не конфликтует.
model Review {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dramaId      String?
  drama        Drama?   @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  novelId      String?
  novel        Novel?   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Оценка отзыва — ОБЩАЯ («Overall»), она же средняя по разделам, если
  // человек их заполнил. Float, а не Int: шкала с половинками (8.5), как
  // у своей оценки сериалу и у MyDramaList.
  rating       Float
  // Оценки по разделам (правка владельца 2026-09-07) — необязательные:
  // модель общая для сериалов, новелл и событий, и «Игра актёров» у
  // новеллы смысла не имеет. Что показывать, решает ReviewsAndComments
  // по типу записи.
  ratingStory  Float?
  ratingActing Float?
  ratingMusic  Float?
  text         String
  // Приватный отзыв видит только автор: в чужих списках его нет, в
  // средний рейтинг и счётчик он не входит (невидимая оценка, двигающая
  // среднее, вызывала бы вопросы). Общий флаг для всех трёх типов.
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, dramaId])
  @@unique([userId, novelId])
  @@unique([userId, eventId])
  @@index([dramaId])
  @@index([novelId])
  @@index([eventId])
}

// Комментарий к сериалу/новелле/событию: плоский или ответ (parentId,
// один уровень вложенности) + лайки.
model Comment {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dramaId   String?
  drama     Drama?         @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  novelId   String?
  novel     Novel?         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Тема обсуждения в сообществе (АА25) — четвёртый вид объекта.
  postId    String?
  post      CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Картинки к комментарию (АА20 и обсуждения сообществ): фото с
  /// концерта, скрин, мем. Отдельной моделью, а не полем: их бывает
  /// несколько, и порядок важен.
  photos    CommentPhoto[]
  parentId  String?
  parent    Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]      @relation("CommentReplies")
  likes     CommentLike[]
  text      String
  createdAt DateTime       @default(now())

  @@index([dramaId])
  @@index([novelId])
  @@index([eventId])
  @@index([postId])
  @@index([parentId])
  @@index([userId])
}

model CommentLike {
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([commentId, userId])
  @@index([userId])
}

// Токен сброса пароля: одноразовый, живёт час. Письмо уходит через SMTP
// (env SMTP_*); без настроенной почты флоу сообщает «недоступно».
model PasswordResetToken {
  token     String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Обращения, модерация, платежи, рассылки, импорты ----------

// Обращение пользователя из формы помощи/поиска: вопрос, предложение
// или запрос на добавление контента (сериала/актёра). Выводится в
// /admin/feedback. TODO: дублировать на почту, когда появится SMTP.
model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      FeedbackKind   @default(QUESTION)
  // Почта для ответа: обращения принимаются и от анонимов (форма
  // открыта), а залогиненным подставляется почта аккаунта.
  email     String?
  text      String
  // Откуда пришло обращение (например, поисковый запрос без результатов).
  context   String?
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())

  @@index([userId])
}

enum FeedbackKind {
  QUESTION
  SUGGESTION
  CONTENT_REQUEST
}

enum FeedbackStatus {
  NEW
  DONE
}

// Жалоба на пользовательский контент (списки, заметки, профили) —
// очередь в /admin/moderation.
model Report {
  id         String       @id @default(cuid())
  reporterId String?
  reporter   User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType String // "placeList" | "profile" | "eventNote"
  targetId   String
  reason     String?
  status     ReportStatus @default(NEW)
  createdAt  DateTime     @default(now())

  @@index([reporterId])
}

enum ReportStatus {
  NEW
  RESOLVED
}

// Журнал оплат Telegram Stars — раньше successful_payment только
// зачислял премиум и терялся в логах; теперь каждая оплата — строка.
model Payment {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider         String    @default("telegram_stars")
  amount           Int // в Stars (XTR)
  telegramChargeId String?   @unique
  // Возврат звёзд (refundStarPayment): Telegram по тому же charge id
  // возвращает оплату пользователю. Держим отметку, чтобы не вернуть
  // дважды и чтобы возвраты не считались в выручке.
  refundedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

// Журнал telegram-рассылок из /admin/broadcast.
model Broadcast {
  id        String   @id @default(cuid())
  text      String
  audience  String // "all" | "premium"
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
}

// Журнал запусков импортов/синков из админки (/admin/imports).
// Что именно создал/обновил автоматический импорт — лента «последнего
// спарсенного» в /admin/imports (руками добавленное сюда не пишется).
model ImportedItem {
  id         String     @id @default(cuid())
  runId      String?
  run        ImportRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  entityType String // performer | agency | event | album | song
  entityId   String
  action     String // created | updated
  label      String
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([runId])
}

model ImportRun {
  id              String         @id @default(cuid())
  // Отметка «разобрано»: бейдж упавших импортов в сайдбаре считает
  // только непросмотренные, иначе гасить его было нечем.
  reviewedAt      DateTime?
  kind            String // "tmdb-dramas" | "tmdb-performers" | "gmmtv" | "mdl-drama" | "blscene"
  status          String         @default("RUNNING") // RUNNING | DONE | FAILED | CANCELLED
  summary         String?
  // Кнопка «Остановить» в /admin/imports: экшен ставит флаг, а сам
  // импорт проверяет его между элементами и выходит сам
  // (checkImportCancelled в src/lib/importRun.ts). Убивать процесс на
  // полуслове нельзя — уже импортированное должно остаться.
  cancelRequested Boolean        @default(false)
  items           ImportedItem[]
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
}

// Ключ-значение настроек сайта, правится в /admin/settings без деплоя
// (цена подписки и т.п.). Читать через src/lib/siteSettings.ts.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Лог серверных ошибок (instrumentation.onRequestError + точечные
// catch'и) — выводится в /admin/errors.
model ErrorLog {
  id         String    @id @default(cuid())
  // Та же отметка, что у ImportRun: счётчик ошибок в сайдбаре считает
  // только неразобранные.
  reviewedAt DateTime?
  message    String
  stack      String?
  path       String?
  digest     String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// Вики-статья («как купить билеты», «виза в Таиланд»…): HTML из
// админ-редактора, публичная страница /wiki/[slug] (ссылки — в футере).
model WikiArticle {
  id        String   @id @default(cuid())
  slug      String?  @unique
  title     String
  content   String   @default("")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// История правок каталога: кто, когда и что поменял. Пишется из
// admin server actions через src/lib/audit.ts (см. docs/features/
// audit-log.md). Раньше правки были анонимны — после появления роли
// менеджера стало неясно, кто затёр поле и что там было раньше.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  MERGE
  BULK
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Подпись автора на момент правки: юзера могут удалить, а история
  // должна остаться читаемой.
  userLabel   String
  action      AuditAction
  // Имя Prisma-модели: "Performer", "Drama", "Event"…
  entityType  String
  entityId    String
  // Название записи на момент правки (после удаления её уже не достать).
  entityLabel String
  // [{ field, label, from, to }] — только реально изменившиеся поля.
  changes     Json?
  // Свободная приписка: «слито с X», «массовое действие: 12 записей».
  note        String?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// Уведомление пользователю на сайте (колокольчик в шапке). Появилось
// после того, как выяснилось: приглашение в поездку приходит молча —
// человек узнаёт о нём, только если сам зайдёт в /trips. Так же тихо
// проходили заявки в друзья, ответы на комментарии и лайки.
// См. docs/features/notifications.md.
enum NotificationKind {
  TRIP_INVITE
  TRIP_INVITE_ACCEPTED
  // Владелец убрал человека из совместной поездки. Уведомление тут
  // обязательно: копия его записей заводится автоматически, и без
  // строки в колокольчике он не узнал бы ни о том, ни о другом.
  TRIP_REMOVED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  COMMENT_REPLY
  COMMENT_LIKE
  FRIEND_GOING
  // «Друг побывал(а) на событии»: та же отметка «иду», но поставленная
  // на УЖЕ прошедшую дату (правка владельца 2026-09-17: уведомление и
  // страница события говорили «идёт» о том, что давно прошло).
  FRIEND_ATTENDED
  PREMIUM_GRANTED
  ACHIEVEMENT
  PERFORMER_BIRTHDAY
  EPISODE_AIRED
  // «Сериал, который вы просили, теперь в каталоге» — резолв заявки
  // MdlDramaRequest после пользовательского импорта списка MDL.
  DRAMA_ADDED
  // «Через час откроется онлайн-бронирование» — по времени, которое
  // владелец записал у своего билета (EventTicket.onlineBookingAt).
  ONLINE_BOOKING
  // «У избранного артиста новое событие» (аудит 2026-09, приоритет №1):
  // каталожное событие с артистом из избранного получателя. Одно на
  // событие, сколько бы избранных ни было в составе.
  PERFORMER_EVENT
  // «Стартовал сериал из ваших планов»: вышла серия №1 у сериала со
  // статусом PLAN_TO_WATCH. Дальше серий этому человеку не шлём — он
  // ещё не смотрит, колокольчик серий у него не включён.
  DRAMA_STARTED
  // Сообщества: заявка на вступление — владельцу, решение по ней —
  // заявителю. Отказ отдельным видом не заводим: молчаливый отказ
  // обиднее внятного «не приняли», но плодить ещё один вид ради одной
  // строки не стоит — текст различает сам COMMUNITY_JOIN_ANSWER.
  COMMUNITY_JOIN_REQUEST
  COMMUNITY_JOIN_ANSWER
  // Позвали в сообщество — единственный путь в закрытое.
  COMMUNITY_INVITE
  // Новая тема в сообществе. В Telegram НЕ уходит по умолчанию: у
  // живого сообщества тем много, и это был бы спам.
  COMMUNITY_POST
  // Месячная сводка владельцу сообщества: сколько новых участников, тем
  // и комментариев за месяц и когда ближайшая встреча. Свой вид, а не
  // чужой: фраза складывается из вида (см. lib/notificationText.ts).
  COMMUNITY_DIGEST
  // «Осталось N дней до поездки» — по одному в день последний месяц
  // перед поездкой, с шуткой на каждый день (АА9). Название поездки
  // в subject, подпись дня — в body.
  TRIP_COUNTDOWN
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  // Кто это сделал — для «Аня пригласила вас в поездку». null у
  // системных (ачивки, выданная подписка).
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Переменные части фразы, замороженные в момент события: имя того,
  // кто её вызвал, и название поездки/события/ачивки. Заморожены
  // потому, что сущность может быть удалена позже, а уведомление
  // должно остаться читаемым; вынесены отдельно потому, что саму фразу
  // складывать при создании нельзя — язык получателя тогда неизвестен,
  // и она собирается при ЧТЕНИИ, на языке того, кто её читает.
  actorName String?
  subject   String?
  // Готовая фраза на языке сайта по умолчанию. Запасной вариант: так
  // читаются строки, созданные до перехода на две части, и такой текст
  // уходит в Telegram (там языка получателя мы тоже не знаем).
  title     String
  body      String?
  // Куда ведёт клик.
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([actorId])
}

// Ссылка у места: инстаграм заведения, сайт, канал в телеграме.
// Отдельной моделью, а не полем: ссылок бывает несколько, и у каждой
// своя подпись.
model LocationLink {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  label      String
  url        String
  createdAt  DateTime @default(now())

  @@index([locationId])
}

// Бронь жилья внутри поездки: файл брони (как билеты у событий —
// EventAttendance.ticketUrl), название и адрес, даты заезда и выезда.
// Видимость наследуется от поездки: участники видят то же, что и
// владелец (см. features/trips.md).
// Бронирования поездки — отели и перелёты в одной модели: поля у них
// почти совпадают (название, даты, ссылка, файл подтверждения,
// заметка), а различаются только маршрутом. Раньше это был TripHotel
// только под жильё.
/// Валюты трат поездки (решение владельца 2026-09-16: «доллары, бел
/// рубли, рос рубли и баты пока»). У всех четырёх два знака после
/// запятой — на этом держится хранение суммы в минорных единицах.
enum TripCurrency {
  THB
  RUB
  BYN
  USD
}

enum TripExpenseCategory {
  FLIGHT
  STAY
  TICKETS
  FOOD
  SHOPPING
  TRANSPORT
  OTHER
}

/// Трата в поездке. ЛИЧНАЯ: «персонально у каждого свои траты»
/// (решение владельца 2026-09-16), поэтому поля видимости тут нет —
/// запись видна только своему автору по построению. Делёжки «кто кому
/// должен» нет тоже, она отменена тем же решением.
model TripExpense {
  id           String              @id @default(cuid())
  tripId       String
  trip         Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// Чья трата. Выборка всегда идёт по паре (поездка, я).
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  /// ЦЕЛЫЕ минорные единицы (сатанги, копейки, центы): дробные деньги в
  /// double дают 0.1 + 0.2 = 0.30000000000000004, и итог по сотне строк
  /// уезжал бы в копейках без причины.
  amountMinor  Int
  currency     TripCurrency
  category     TripExpenseCategory @default(OTHER)
  /// День траты, без времени.
  spentOn      DateTime?
  /// Необязательная привязка к брони: перелёты и отели сайт уже знает.
  /// SetNull — удалили бронь, трата осталась: деньги-то потрачены.
  bookingId    String?
  booking      TripBooking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  /// Или к событию афиши: у фестиваля несколько дней, поэтому ссылка на
  /// конкретную дату (EventOccurrence), а не на событие вообще.
  /// Цены у самого события быть не может — оно общее для всех, а билет
  /// и сумма у каждого свои.
  occurrenceId String?
  occurrence   EventOccurrence?    @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime            @default(now())

  @@index([tripId, userId])
  @@index([bookingId])
}

enum TripBookingKind {
  HOTEL
  FLIGHT
}

model TripBooking {
  id          String             @id @default(cuid())
  tripId      String
  trip        Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  kind        TripBookingKind    @default(HOTEL)
  // Отель: название; перелёт: рейс или авиакомпания («TG 975»).
  name        String
  // Отель: адрес. У перелёта не используется.
  address     String?
  // Перелёт: откуда и куда (город или аэропорт).
  fromPlace   String?
  toPlace     String?
  // Ссылка на саму бронь (Booking, письмо) и загруженный файл/скрин.
  url         String?
  fileUrl     String?
  // Отель: заезд/выезд; перелёт: вылет/прилёт.
  startAt     DateTime?
  endAt       DateTime?
  note        String?
  // Кто видит бронь. По умолчанию участники: адрес проживания и номер
  // брони — не то, что показывают всем подряд.
  // Кто завёл бронь. Без этого поля приватная бронь участницы
  // считалась приватной бронью ВЛАДЕЛЬЦА: автор подставлялся владельцем
  // по умолчанию, и своя же запись исчезала у автора, зато была видна
  // хозяйке поездки (поймано проверкой совместной поездки 2026-09-06).
  createdById String?
  visibility  TripItemVisibility @default(PARTICIPANTS)
  createdAt   DateTime           @default(now())

  expenses TripExpense[]

  /// Цена записи — она же строка в расходах поездки (правка владельца
  /// 2026-09-16). Минорные единицы, как у TripExpense; валюта своя у
  /// каждой записи: перелёт часто в рублях, отель в батах.
  /// Отдельной траты при заполнении НЕ создаётся: вкладка расходов
  /// читает цену отсюда, а копия пришлось бы держать в синхроне.
  priceMinor    Int?
  priceCurrency TripCurrency?

  // Кто летит этим рейсом / живёт в этом отеле — по строке на участника
  // поездки, у каждого свой билет (правка владельца 2026-09-19: один
  // рейс на четверых — одна бронь, а не четыре).
  participants TripBookingParticipant[]

  @@index([tripId])
}

// Участник брони: летит этим рейсом / живёт в этом отеле. fileUrl — его
// СВОЙ билет или подтверждение (приватное хранилище, папка hotels, как у
// общего файла брони); общий файл брони живёт в TripBooking.fileUrl.
model TripBookingParticipant {
  bookingId String
  userId    String
  booking   TripBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl   String?
  createdAt DateTime    @default(now())

  @@id([bookingId, userId])
  @@index([userId])
}

// «Видела вживую» вручную: концерты до регистрации на сайте, случайные
// встречи и события, которых нет в нашей афише. Считается в статистике
// наравне с отметками «я ходил(а)» — см. features/gamification.md.
/// День личного события: дата, время и СВОЙ состав. Фестиваль на три
/// дня с разными артистами каждый день — три строки; ужин с актёром —
/// одна.
model TripPersonalEventDay {
  id              String                          @id @default(cuid())
  personalEventId String
  personalEvent   TripPersonalEvent               @relation(fields: [personalEventId], references: [id], onDelete: Cascade)
  /// Настенное время в UTC-слоте, как у всей поездки; без времени —
  /// 00:00 (та же договорённость, что у самого события).
  startsAt        DateTime
  performers      TripPersonalEventDayPerformer[]
  seen            TripPersonalEventSeen[]

  @@index([personalEventId])
}

model TripPersonalEventDayPerformer {
  id          String               @id @default(cuid())
  dayId       String
  day         TripPersonalEventDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  performerId String
  performer   Performer            @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@unique([dayId, performerId])
  @@index([performerId])
}

// «Я там буду» на личном событии — отметка КАЖДОГО участника своя, как
// «иду» на афише (решение владельца): в совместной поездке встречу
// создаёт один, а идут не все. Автору ставится при создании записи по
// умолчанию (создала = собираюсь; для планов-кандидатов снимается).
// Артисты события попадают в «видел(а) вживую» только отметившимся —
// и только после даты; см. lib/userStats.ts.
/// Кого видел(а) на дне личного события — СВОЯ отметка каждого
/// участника (правка владельца 2026-09-19). Состав дня
/// (TripPersonalEventDayPerformer) — общий список «кто был», а «видела
/// вживую» считается по этим строкам: кто добавил артиста, у того он
/// отмечен сразу, у остальных — нет, пока не нажмут глазик.
model TripPersonalEventSeen {
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayId       String
  day         TripPersonalEventDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  performerId String
  performer   Performer            @relation(fields: [performerId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())

  @@id([userId, dayId, performerId])
  @@index([dayId])
  @@index([performerId])
}

model TripPersonalEventAttendance {
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalEventId String
  personalEvent   TripPersonalEvent @relation(fields: [personalEventId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())

  @@id([userId, personalEventId])
  @@index([personalEventId])
}

// И5: «не сливать» на странице дублей. В группы попадают не только
// дубли — ремейк с тем же названием, тёзки с одним ником, — а сделать
// с такой парой было нечего: слить нельзя, убрать из списка тоже, и
// она мозолила глаза при каждом заходе. Скрытие привязано к ТОЧНОМУ
// составу группы (отсортированные id через «|»): появится третий
// кандидат — состав изменится и группа вернётся в список сама.
model DuplicateDismissal {
  id         String   @id @default(cuid())
  // "drama" | "performer" | "agency" — строкой: enum ради трёх значений
  // раздул бы клиент, а пишет сюда только своя админка.
  entityType String
  memberKey  String
  createdAt  DateTime @default(now())

  @@unique([entityType, memberKey])
}

// «Видели вживую ВНЕ нашей афиши»: концерт до регистрации на сайте,
// случайная встреча, событие, которого у нас нет. Ручная отметка на
// артиста, одна на человека. Считается как ещё одно «событие» в
// статистике (+1 к счётчику артиста).
//
// До 2026-09-15 здесь же жило и «НЕ видела, хотя автоматика говорит
// видела» (колонка seen=false) — на артиста целиком, без события. Это и
// ломало счёт: снять Jeff Satur с одного фестиваля значило снять его со
// всех шести концертов. Теперь спор с автоматикой живёт у события —
// EventSeenPerformer ниже. См. docs/features/gamification.md.
model PerformerSeen {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)
  seenAt      DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@unique([userId, performerId])
  @@index([userId])
  @@index([performerId])
}

// Решение человека «видела ЭТОГО артиста на ЭТОМ событии» — поверх
// умолчания (правка владельца 2026-09-15). Умолчание считает
// src/lib/seenLive.ts: у обычного концерта, на который стоит «иду»,
// увидены все из состава; у дня фестиваля со своим лайнапом — никто
// (три сцены, тридцать групп — отметить троих проще, чем снять
// двадцать семь). Строка заводится только там, где человек с умолчанием
// не согласен: seen=true — «видела» (отметила на фестивале), seen=false
// — «не видела» (на концерте пятеро, разглядела двоих). Ключ — событие,
// не день: сходили на оба дня, где артист играл дважды, — всё равно
// «видели один раз».
model EventSeenPerformer {
  userId      String
  eventId     String
  performerId String
  seen        Boolean
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@id([userId, eventId, performerId])
  @@index([eventId])
  @@index([performerId])
}

// Расписание фоновых задач: что запускается само, когда и по кому.
// До этого интервалы были зашиты в код (см. src/instrumentation.ts) —
// поменять час прогона можно было только деплоем, а список артистов для
// проверки новинок не выбирался вовсе. Страница — /admin/schedule.
model ScheduledJob {
  // Ключ задачи в коде: "youtube-music", "tmdb-dramas"…
  key         String               @id
  enabled     Boolean              @default(true)
  // Час запуска в зоне сайта (Europe/Moscow, см. TZ в docker-compose).
  hour        Int                  @default(4)
  // Кого проверяем: всех подходящих или только выбранных вручную.
  targetMode  ScheduleTargetMode   @default(ALL)
  targets     ScheduledJobTarget[]
  lastRunAt   DateTime?
  lastStatus  String?
  lastSummary String?
  // «Задаче есть что доделать — продолжи в это время». Ставится, когда
  // прогон упёрся в потолок пачки (обновление MDL берёт по 300 карточек
  // из 626) или оборвался перезапуском. Планировщик тикает раз в 10
  // минут и по наступившему resumeAt запускает задачу ВНЕ суточного
  // правила, пока не разберёт всё. Пусто — обычное «раз в сутки».
  resumeAt    DateTime?
  updatedAt   DateTime             @updatedAt

  @@index([enabled])
}

enum ScheduleTargetMode {
  ALL
  SELECTED
}

// Артист, включённый в задачу вручную (targetMode = SELECTED).
model ScheduledJobTarget {
  id          String       @id @default(cuid())
  jobKey      String
  job         ScheduledJob @relation(fields: [jobKey], references: [key], onDelete: Cascade)
  performerId String
  performer   Performer    @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@unique([jobKey, performerId])
  @@index([jobKey])
  @@index([performerId])
}

// Заявка «добавьте сериал»: ненайденная строка пользовательского импорта
// списка MDL (см. features/mydramalist-import.md). Одна заявка на
// страницу MDL — дедуп по каноническому mdlUrl, просившие юзеры копятся
// в MdlDramaRequestUser. Владелец видит открытые заявки в /admin/imports
// и запускает точечный импорт; когда сериал с этой страницей появляется
// в каталоге ЛЮБЫМ путём (хук в upsertDramaFromMdl), заявка резолвится:
// просившим дописывается их статус (не перетирая уже заведённый) и
// уходит уведомление DRAMA_ADDED. notifiedAt — защита от повторной
// рассылки; резолвим только открытые (resolvedAt == null).
model MdlDramaRequest {
  id              String    @id @default(cuid())
  // Канонический адрес страницы MDL (canonicalMdlUrl) — ключ дедупа,
  // как Drama.mdlUrl.
  mdlUrl          String    @unique
  // Название с MDL — замороженное: сериала у нас ещё нет, а админке
  // нужно что-то показать.
  title           String
  createdAt       DateTime  @default(now())
  // Проставлены разом при появлении сериала в каталоге.
  resolvedAt      DateTime?
  resolvedDramaId String?
  resolvedDrama   Drama?    @relation(fields: [resolvedDramaId], references: [id], onDelete: SetNull)
  notifiedAt      DateTime?
  // «Отклонить» в админке: мусорная ссылка. Запись остаётся, чтобы
  // повторный импорт списка не воскрешал заявку; но если сериал всё же
  // появится в каталоге, хук её резолвит и уведомит просивших.
  rejectedAt      DateTime?

  users MdlDramaRequestUser[]

  @@index([resolvedAt, rejectedAt])
  @@index([resolvedDramaId])
}

// Кто просил и с каким статусом/прогрессом в своём списке MDL: при
// резолве заявки статус дописывается юзеру автоматически — он просил
// импорт именно статусов. Повторный импорт списка освежает статус в
// заявке (последняя просьба — актуальная).
model MdlDramaRequestUser {
  requestId       String
  request         MdlDramaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          WatchStatus
  // Прогресс из списка; валидируется против Drama.episodes при резолве,
  // не при записи — числа серий у нас в этот момент ещё нет.
  episodesWatched Int?
  createdAt       DateTime        @default(now())

  @@id([requestId, userId])
  @@index([userId])
}

// Черновики событий из краулера афиши ThaiTicketMajor (см.
// docs/features/ttm-crawl.md). СВОЯ таблица, а не флаг на Event:
// до одобрения владельцем краулер публичной таблицы не касается вовсе —
// иначе каждую публичную выборку пришлось бы фильтровать, и одна
// пропущенная стала бы утечкой неподтверждённого события.
//
// Таблица заодно и память краулера: обработанный sourceUrl повторно не
// перекачивается. REJECTED — вечная память (обход не воскрешает);
// NO_MATCH (в составе никого из каталога) перепроверяется, когда
// checkedAt старше недели — артист мог появиться в каталоге позже.
model EventDraft {
  id                String           @id @default(cuid())
  // Канонический адрес страницы события (без utm-хвостов) — ключ дедупа.
  sourceUrl         String           @unique
  // Весь распарс страницы (TtmEvent: название, даты, площадка, цены,
  // постер-URL, пресейл, состав) — Json, а не колонки: черновик живёт
  // до решения владельца, событие создаётся существующим импортом.
  payload           Json
  // Совпавшие с каталогом артисты: [{performerId, nickname}]. Json, а
  // не join-таблица: нужны только чипы в очереди и привязка состава при
  // одобрении; удалённый из каталога артист просто отвалится при
  // создании события.
  matchedPerformers Json
  status            EventDraftStatus @default(PENDING)
  // Событие, созданное одобрением (для ссылки «открыть» из истории).
  eventId           String?
  createdAt         DateTime         @default(now())
  // Последняя проверка краулером — по ней NO_MATCH уходит на re-check.
  checkedAt         DateTime         @default(now())
  reviewedAt        DateTime?

  @@index([status])
}

enum EventDraftStatus {
  PENDING
  APPROVED
  REJECTED
  // Совпадений с каталогом нет — событие не наше, но запоминаем, чтобы
  // не перекачивать; перепроверяется раз в неделю.
  NO_MATCH
}

// Черновики маскотов GMMTV со страницы Mascots фан-вики (задача
// "gmmtv-mascots", см. docs/features/gmmtv-mascots-import.md). Своя
// таблица по тем же соображениям, что EventDraft: до одобрения владельцем
// краулер публичной таблицы Performer не касается вовсе. Таблица заодно
// и память краулера: REJECTED повторный обход не воскрешает.
model MascotDraft {
  id            String            @id @default(cuid())
  // Нормализованное имя маскота (NFKC + casefold + схлопнутые пробелы,
  // см. normalizeMascotName) — ключ дедупа. Именно имя, а не адрес: у
  // маскота нет своей страницы на вики, только якорь-секция общей
  // Mascots, и якорь — производная того же имени; а дедуп против
  // каталога (Performer type MASCOT, в т.ч. заведённые руками) всё
  // равно возможен только по имени.
  nameKey       String            @unique
  // Имя как на вики — для карточки очереди и создаваемого Performer.
  name          String
  // Ссылка на секцию маскота (…/wiki/Mascots#Якорь) — «открыть на вики».
  sourceUrl     String
  // Весь распарс секции (GmmtvMascot: описание, картинка, владельцы,
  // соцсети) — Json, а не колонки: черновик живёт до решения владельца.
  payload       Json
  // Совпавшие с каталогом владельцы: [{performerId, name, type}] —
  // Json, а не join-таблица, как matchedPerformers у EventDraft: нужны
  // только чипы в очереди и привязка MascotOwner при одобрении.
  // Несовпавшие имена лежат в payload.unmatchedOwners.
  matchedOwners Json
  status        MascotDraftStatus @default(PENDING)
  // Performer типа MASCOT, созданный одобрением (или найденный по имени,
  // если маскота успели завести руками, пока черновик ждал).
  performerId   String?
  createdAt     DateTime          @default(now())
  reviewedAt    DateTime?

  @@index([status])
}

enum MascotDraftStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------
// Сообщества (АА25): «Лакорны Беларусь» и подобное — место, где люди
// находят единомышленников. Заводить может обладатель подписки, вступать
// — любой вошедший (правила вступления настраиваются владельцем).
//
// Структурно это близкий родственник совместной поездки: владелец,
// участники, видимость. Отдельная модель, а не поездка с флагом:
// у поездки есть даты и план, у сообщества их нет и не будет.
// ---------------------------------------------------------------------

enum CommunityVisibility {
  // Витрину видит кто угодно, включая поисковики; содержимое — только
  // участники (см. docs/features/communities.md).
  PUBLIC
  // Не в поиске и не в общем списке: попасть можно только по ссылке, а
  // увидеть внутри — только вступив.
  PRIVATE
}

enum CommunityJoinMode {
  /// Вступают сразу, без спроса.
  OPEN
  /// Заявка ждёт решения владельца.
  APPROVAL
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityMemberStatus {
  /// Заявка подана, решения ещё нет (только при joinMode = APPROVAL).
  PENDING
  ACTIVE
  /// Выгнали. Строка остаётся: без неё человек просто вступил бы заново.
  BANNED
}

model Community {
  id           String                 @id @default(cuid())
  // Слаг с коротким кодом (CODED_SLUG_MODELS в src/lib/prisma.ts):
  // названия у людей повторяются, а нумерация -2/-3 выдавала бы, сколько
  // всего таких сообществ завели.
  slug         String?                @unique
  ownerId      String
  owner        User                   @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  // Баннер-обложка на странице сообщества.
  coverUrl     String?
  visibility   CommunityVisibility    @default(PUBLIC)
  joinMode     CommunityJoinMode      @default(OPEN)
  // Где живёт сообщество (АА25). Городские и страновые сообщества
  // («Лакорны Беларусь») любят ВСЕХ актёров и все сериалы — привязать их
  // к каталогу нечем, и найти их можно только по месту. Поэтому у места
  // свои поля и свой фильтр витрины, а не сотня привязок к артистам.
  country      String?
  city         String?
  // Таймзона сообщества (IANA): в ней вводится время встреч. При
  // создании — зона создателя (User.timezone), дальше правится в
  // «Управлении». null — старые записи до бэкфила; читатели берут
  // DEFAULT_TIMEZONE.
  timezone     String?
  links        CommunityLink[]
  achievements CommunityAchievement[]
  placeLists   PlaceList[]
  trips        Trip[]
  members      CommunityMember[]
  invites      CommunityInvite[]
  posts        CommunityPost[]
  /// Встречи сообщества — те же Event, но со ссылкой сюда: карточка,
  /// «я иду», комментарии и карта достаются им бесплатно. В каталожную
  /// афишу они НЕ попадают, см. catalogEventsWhere.
  events       Event[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([ownerId])
}

/// Ссылки сообщества (свой чат в Telegram, канал, гуглодок с правилами).
/// Отдельной моделью, как PerformerLink: их число заранее не известно.
/// Видны только участникам — за ссылкой обычно закрытый чат.
model CommunityLink {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  label       String
  url         String
  createdAt   DateTime  @default(now())

  @@index([communityId])
}

model CommunityMember {
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityRole         @default(MEMBER)
  status      CommunityMemberStatus @default(ACTIVE)
  createdAt   DateTime              @default(now())

  @@id([communityId, userId])
  @@index([userId])
  @@index([communityId, status])
}

/// Приглашение в сообщество. Для закрытых это единственный способ
/// попасть внутрь: заявок с улицы они не принимают. Приглашённый
/// становится участником, приняв приглашение, — молча зачислять человека
/// в сообщество нельзя.
model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  /// Кого зовут.
  userId      String
  user        User      @relation("CommunityInviteTo", fields: [userId], references: [id], onDelete: Cascade)
  /// Кто позвал — для строки «Аня зовёт вас в сообщество».
  invitedById String
  invitedBy   User      @relation("CommunityInviteBy", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([userId])
  @@index([invitedById])
}

/// Тема обсуждения в сообществе. Комментарии к ней — общая модель
/// Comment (поле postId), лайки и жалобы работают как везде.
model CommunityPost {
  id          String               @id @default(cuid())
  communityId String
  community   Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String?
  text        String
  /// Закреплённая тема — правила сообщества, знакомство, объявление.
  pinned      Boolean              @default(false)
  /// Приватная тема видна только участникам. Публичная попадает в
  /// список, который видят и посторонние (правка владельца
  /// 2026-09-09): по такому списку видно, живое ли сообщество, и
  /// становится понятно, ради чего в него вступать. ОТКРЫТЬ тему
  /// по-прежнему может только участник — снаружи виден заголовок,
  /// а не разговор.
  isPrivate   Boolean              @default(false)
  /// Картинки самой темы. Своя модель, а не «служебный комментарий с
  /// фотографиями»: призрачная строка в общей таблице комментариев
  /// заставляла бы каждое место, которое их считает или показывает
  /// (лента, счётчики, админская модерация), знать про исключение.
  photos      CommunityPostPhoto[]
  comments    Comment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([communityId, createdAt])
  @@index([authorId])
}

/// Фото, прикреплённое к комментарию: к отзыву о событии (АА20) и к
/// обсуждению в сообществе. Лежит в общем /uploads через ту же ручку,
/// что и остальные картинки — там же и потолки размера.
model CommentPhoto {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([commentId])
}

/// Фото, приложенное к теме обсуждения. Устроено как `CommentPhoto` и
/// показывается тем же компонентом — разница только в том, к чему
/// прицеплено.
model CommunityPostPhoto {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  sort      Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([postId])
}

// Дневник серий (аудит 2026-09): отметка КОНКРЕТНОЙ серии с датой и
// необязательной заметкой-впечатлением. Живёт рядом со счётчиком
// episodesWatched, не вместо него: счётчик — быстрый прогресс, дневник —
// память. Материал для «итогов года» и будущих эпизодных обсуждений.
model EpisodeWatch {
  userId    String
  dramaId   String
  episode   Int
  watchedAt DateTime @default(now())
  note      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)

  @@id([userId, dramaId, episode])
  @@index([dramaId])
}

/// Правимый словарь повторяющихся значений из импорта: жанр, страна,
/// тип сериала, страна артиста, занятие, инструмент. Значения по
/// умолчанию живут в коде (src/lib/contentDictionary.ts) — здесь только
/// то, что владелец поправила или добавила через /admin/translations.
/// `source` — сырое значение в нижнем регистре: источники пишут одно и
/// то же вразнобой («Actor» и «actor»).
model ContentTranslation {
  id        String   @id @default(cuid())
  kind      String
  source    String
  ru        String
  updatedAt DateTime @updatedAt

  @@unique([kind, source])
}
