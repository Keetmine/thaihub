# Copy this file to .env (local dev) and fill in real values.
# For `docker compose up`, the same .env file (next to docker-compose.yml)
# is used to fill in ADMIN_PASSWORD / ADMIN_SESSION_SECRET — the DATABASE_URL
# for the app container is set directly in docker-compose.yml instead.

# Local (non-Docker) dev — point at a Postgres you're running yourself,
# e.g. `createdb thaitrack` against a local Postgres server.
DATABASE_URL="postgresql://USER@localhost:5432/thaitrack?schema=public"

# Required for `docker compose up` (db/app/backup): compose refuses to
# start without it — there is deliberately no default password. Locally
# any value works; in prod use a long random one (`openssl rand -hex 24`)
# and never change it after the db volume is initialized.
POSTGRES_PASSWORD="change-me-too"

# Admin panel login.
ADMIN_PASSWORD="change-me-please"
# Any long random string — e.g. `openssl rand -hex 24`.
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Optional: Telegram login + event reminder notifications. Both come from
# one bot created via @BotFather; the login widget additionally needs the
# site's domain bound to the bot with /setdomain (it won't render on
# localhost). Leave unset to hide the Telegram login button entirely.
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# TELEGRAM_BOT_USERNAME="MyThaiHubBot"
# Бот у прода и у локальной машины ОДИН, поэтому вне production
# сообщения не отправляются, а пишутся в консоль — иначе каждое
# админ-уведомление приходило бы дважды. Раскомментируйте, чтобы
# проверить настоящую отправку со своей машины.
# TELEGRAM_ALLOW_OUTBOUND=1
# Фоновые задачи (напоминания, обход афиши, импорты по расписанию) вне
# production не запускаются: иначе локальная машина шлёт те же
# уведомления и ходит на те же сайты параллельно с сервером.
# Раскомментируйте, чтобы проверить планировщик у себя.
# RUN_BACKGROUND_JOBS=1
# Absolute origin used in Telegram messages to build event links.
# APP_URL="https://example.com"
# Payments via Telegram Stars: price per month + webhook auth secret
# (any long random string; register the webhook once with
# `npx tsx scripts/setup-telegram-webhook.ts` after deploy).
# PREMIUM_PRICE_STARS="250"
# TELEGRAM_WEBHOOK_SECRET="replace-with-a-long-random-string"

# Optional: TMDB importer (see docs/features/tmdb-import.md).
# TMDB_API_READ_ACCESS_TOKEN="..."

# Optional: analytics. Both only load after the visitor accepts all
# cookies (see CookieConsent) — without these the site simply runs
# without counters. If the GTM container fires GA4 itself, leave
# GA_MEASUREMENT_ID empty or the same visit is counted twice.
# GTM_ID="GTM-XXXXXXX"
# GA_MEASUREMENT_ID="G-XXXXXXXXXX"
