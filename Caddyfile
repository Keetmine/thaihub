# HTTPS-фронт для MyBLHub: Caddy сам выпускает/продлевает сертификаты
# Let's Encrypt для {$DOMAIN} (env задаётся в docker-compose). При
# DOMAIN=localhost работает как обычный локальный reverse-proxy c
# самоподписанным сертификатом.
{$DOMAIN} {
	encode gzip zstd

	# Билеты переехали в приватное хранилище (/files/… через приложение,
	# scripts/migrate-private-uploads.ts) — старый публичный путь глушим
	# на случай, если где-то остался файл или закладка.
	handle /uploads/tickets/* {
		respond 404
	}

	# Загруженные картинки отдаёт Caddy напрямую из общего с приложением
	# volume: Next знает только те файлы public/, что были на момент
	# сборки, и на всё загруженное позже отвечает 404. Кэшируем
	# агрессивно — имена контентно-стабильные (uuid / TMDB-id).
	handle /uploads/* {
		header Cache-Control "public, max-age=2592000, immutable"
		root * /srv
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}
